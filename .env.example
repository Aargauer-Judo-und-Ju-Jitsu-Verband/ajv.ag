PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key
# Webling REST API key for the /api/events Netlify Function (server-side only,
# NOT prefixed PUBLIC_ so it is never exposed to the browser). Set the real value
# in the Netlify UI under Site settings → Environment variables.
WEBLING_API_KEY=your_webling_api_key
# Kantonalkader-Stützpunkttermine: als CSV veröffentlichtes Google Sheet
# (Datei → Freigeben → Im Web veröffentlichen → CSV). Wird zur Build-Zeit gelesen.
PUBLIC_KADER_SHEET_CSV=https://docs.google.com/spreadsheets/d/e/XXXX/pub?gid=0&single=true&output=csv
