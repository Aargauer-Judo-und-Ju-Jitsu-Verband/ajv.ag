---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrganizationSchema from '../components/seo/OrganizationSchema.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import EventList from '../components/EventList.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout
  title="Startseite"
  description="Aargauer Judo und Ju-Jitsu Verband (AJV) — der Dachverband für Judo und Ju-Jitsu im Kanton Aargau. 14 Vereine, Kantonalkader und Wettkämpfe seit 1963."
>
  <OrganizationSchema slot="head" />

  <!-- Hero -->
  <section class="relative bg-brand-700 text-white clip-diagonal hero-overlay overflow-hidden">
    <!-- Club logo network background — right side -->
    <div class="!absolute inset-0 pointer-events-none hidden lg:block !z-[1]" aria-hidden="true">
      {[
        { logo: '/images/clubs/aarau.webp', x: '50%', y: '8%', size: 'h-12', delay: '0s', dur: '18s' },
        { logo: '/images/clubs/baden-wettingen.webp', x: '75%', y: '12%', size: 'h-11', delay: '2s', dur: '22s' },
        { logo: '/images/clubs/brugg.webp', x: '62%', y: '22%', size: 'h-13', delay: '1s', dur: '20s' },
        { logo: '/images/clubs/bad-zurzach.webp', x: '88%', y: '25%', size: 'h-10', delay: '3s', dur: '24s' },
        { logo: '/images/clubs/bushido-frick.webp', x: '52%', y: '36%', size: 'h-11', delay: '4s', dur: '19s' },
        { logo: '/images/clubs/arashi-kulm.webp', x: '78%', y: '38%', size: 'h-10', delay: '2.5s', dur: '21s' },
        { logo: '/images/clubs/lenzburg.webp', x: '92%', y: '42%', size: 'h-11', delay: '1.5s', dur: '23s' },
        { logo: '/images/clubs/magden.webp', x: '58%', y: '50%', size: 'h-12', delay: '3.5s', dur: '17s' },
        { logo: '/images/clubs/moehlin.webp', x: '82%', y: '52%', size: 'h-10', delay: '0.5s', dur: '25s' },
        { logo: '/images/clubs/movimento-wohlen.webp', x: '68%', y: '62%', size: 'h-11', delay: '4.5s', dur: '20s' },
        { logo: '/images/clubs/muri.webp', x: '90%', y: '60%', size: 'h-10', delay: '2s', dur: '22s' },
        { logo: '/images/clubs/reinach.webp', x: '55%', y: '72%', size: 'h-12', delay: '3s', dur: '18s' },
        { logo: '/images/clubs/rothrist.webp', x: '76%', y: '74%', size: 'h-10', delay: '1s', dur: '24s' },
        { logo: '/images/clubs/jac-wohlen.webp', x: '65%', y: '82%', size: 'h-11', delay: '5s', dur: '21s' },
      ].map((item) => (
        <img
          src={item.logo}
          alt=""
          class={`absolute ${item.size} w-auto object-contain opacity-[0.15] brightness-[2] saturate-0 hero-logo-float`}
          style={`left: ${item.x}; top: ${item.y}; animation-delay: ${item.delay}; animation-duration: ${item.dur};`}
        />
      ))}
    </div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-36 pb-32 lg:pb-44 relative z-10">
      <div class="max-w-4xl">
        <p class="animate-fade-up text-brand-200 text-xs font-semibold uppercase tracking-[0.3em] mb-6">
          Seit 1963
        </p>
        <h1 class="animate-fade-up stagger-1 font-display text-4xl sm:text-5xl lg:text-7xl font-extrabold leading-[0.95] tracking-tight">
          Aargauer Judo<br />
          <span class="text-brand-200">&</span> Ju-Jitsu Verband
        </h1>
        <p class="animate-fade-up stagger-2 mt-8 text-lg lg:text-xl text-brand-200 max-w-2xl leading-relaxed">
          Wir fördern Judo und Ju-Jitsu auf allen Wettkampfstufen und setzen uns
          für die Werte Respekt, Disziplin, Mut und Freundschaft ein.
        </p>
        <div class="animate-fade-up stagger-3 mt-10 flex flex-wrap gap-4">
          <a
            href="/aktuelles"
            class="px-6 py-3 bg-white text-brand-700 font-semibold text-sm tracking-wide rounded-md hover:bg-stone-100 transition-colors"
          >
            Aktuelles
          </a>
          <a
            href="/kantonalkader"
            class="px-6 py-3 bg-brand-500 text-white font-semibold text-sm tracking-wide rounded-md hover:bg-brand-400 transition-colors border border-brand-400/30"
          >
            Kantonalkader
          </a>
          <a
            href="/vereine"
            class="px-6 py-3 bg-brand-500 text-white font-semibold text-sm tracking-wide rounded-md hover:bg-brand-400 transition-colors border border-brand-400/30"
          >
            Vereine
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Events Preview -->
  <section class="relative -mt-12 lg:-mt-20 z-10 pb-16 lg:pb-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="sr-only">Nächste Veranstaltungen</h2>
      <div class="grid lg:grid-cols-2 gap-6">
        <!-- AJV -->
        <div class="bg-white border border-stone-200 rounded-lg shadow-lg p-6 lg:p-8">
          <div class="flex items-center gap-2 mb-5">
            <span class="w-2 h-2 rounded-full bg-brand-600"></span>
            <h3 class="font-display text-xl font-bold text-stone-900">AJV Anlässe und Kurse</h3>
          </div>
          <EventList maxEvents={5} compact calendars={['AJV']} />
        </div>
        <!-- Kantonalkader & SMM -->
        <div class="bg-white border border-stone-200 rounded-lg shadow-lg p-6 lg:p-8">
          <div class="flex items-center gap-2 mb-5">
            <span class="w-2 h-2 rounded-full bg-stone-400"></span>
            <h3 class="font-display text-xl font-bold text-stone-900">Kantonalkader &amp; SMM</h3>
          </div>
          <EventList maxEvents={5} compact exclude={['AJV']} />
        </div>
      </div>
      <div class="mt-6 text-center">
        <a
          href="/veranstaltungen"
          class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 hover:text-brand-700 transition-colors group"
        >
          Alle Termine
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- News -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-end justify-between mb-12">
        <div>
          <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">Neuigkeiten</p>
          <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">Aktuelles</h2>
        </div>
        <a
          href="/aktuelles"
          class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-stone-500 hover:text-brand-600 transition-colors group"
        >
          Alle Beiträge
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a href={`/aktuelles/${post.id}`} class="group">
            <article class="bg-white border border-stone-200 rounded-lg overflow-hidden h-full card-hover">
              {post.data.image && (
                <div class="aspect-[16/9] overflow-hidden bg-stone-100">
                  <Image
                    src={post.data.image}
                    alt={post.data.imageAlt || post.data.title}
                    width={640}
                    height={360}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
              )}
              <div class="p-6 lg:p-7">
                <time class="text-xs text-stone-500 uppercase tracking-wider" datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('de-CH', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <h3 class="mt-3 font-display text-xl font-semibold text-stone-900 group-hover:text-brand-600 transition-colors leading-snug">
                  {post.data.title}
                </h3>
                <p class="mt-3 text-sm text-stone-500 leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>
                <span class="inline-flex items-center gap-1 mt-5 text-xs font-semibold text-brand-600 uppercase tracking-wider group-hover:text-brand-700 transition-colors">
                  Weiterlesen
                  <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </article>
          </a>
        ))}
      </div>
      <a href="/aktuelles" class="sm:hidden inline-flex items-center gap-2 mt-8 text-sm font-semibold text-brand-600">
        Alle Beiträge &rarr;
      </a>
    </div>
  </section>

  <!-- Kantonalkader / AJV Angebote -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-4">Nachwuchsförderung</p>
          <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 leading-tight heading-accent">
            Kantonalkader Judo
          </h2>
          <p class="mt-8 text-stone-600 text-lg leading-relaxed">
            Das Kantonalkader ist das zentrale Fördergefäss für junge Judoka der Kategorien U11, U13 und U15.
            Wöchentliche Stützpunkttrainings, Wettkampfvorbereitung und der Weg in den nationalen Leistungssport.
          </p>
          <div class="mt-6 grid grid-cols-2 gap-4">
            {[
              { label: 'Stützpunkttraining', desc: 'Samstag, 10–12 Uhr in Windisch' },
              { label: 'NLZ Academy', desc: 'Regionales Leistungszentrum' },
              { label: 'Ranking Turniere', desc: 'Qualifikation für internationale Einsätze' },
              { label: 'Probetraining', desc: 'Jederzeit ohne Voranmeldung' },
            ].map((item) => (
              <div class="bg-stone-50 border border-stone-200 rounded-lg p-4">
                <h3 class="font-display text-sm font-bold text-stone-900">{item.label}</h3>
                <p class="mt-1 text-xs text-stone-500 leading-relaxed">{item.desc}</p>
              </div>
            ))}
          </div>
          <a
            href="/kantonalkader"
            class="inline-flex items-center gap-2 mt-8 text-sm font-semibold text-brand-600 tracking-wide hover:text-brand-700 transition-colors group"
          >
            Mehr zum Kantonalkader
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="relative">
          <div class="aspect-[4/3] bg-stone-100 rounded-lg overflow-hidden">
            <img
              src="/images/events/ju-jitsu-day-1.webp"
              alt="Judo Training im Kanton Aargau"
              class="w-full h-full object-cover"
            />
          </div>
          <div class="absolute -bottom-3 -right-3 w-full h-full border-2 border-brand-200 rounded-lg -z-10"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Clubs -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">14 Vereine</p>
        <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">
          Unsere Vereine
        </h2>
        <p class="mt-4 text-stone-600 leading-relaxed max-w-xl mx-auto">
          14 Vereine im Kanton Aargau bieten Judo und Ju-Jitsu für alle Altersklassen an.
        </p>
      </div>
      <div class="mt-12 grid grid-cols-4 sm:grid-cols-5 md:grid-cols-7 gap-6 lg:gap-8 items-center justify-items-center">
        {[
          { name: 'JJC Aarau', logo: '/images/clubs/aarau.webp' },
          { name: 'JC Baden-Wettingen', logo: '/images/clubs/baden-wettingen.webp' },
          { name: 'JJJC Brugg', logo: '/images/clubs/brugg.webp' },
          { name: 'JC Bad Zurzach', logo: '/images/clubs/bad-zurzach.webp' },
          { name: 'Bushido Frick', logo: '/images/clubs/bushido-frick.webp' },
          { name: 'JC Arashi Kulm', logo: '/images/clubs/arashi-kulm.webp' },
          { name: 'Aikido- und Judoschule Lenzburg', logo: '/images/clubs/lenzburg.webp' },
          { name: 'JC Magden', logo: '/images/clubs/magden.webp' },
          { name: 'JJJC Möhlin', logo: '/images/clubs/moehlin.webp' },
          { name: 'Movimento Wohlen', logo: '/images/clubs/movimento-wohlen.webp' },
          { name: 'JC Muri', logo: '/images/clubs/muri.webp' },
          { name: 'JC Reinach AG', logo: '/images/clubs/reinach.webp' },
          { name: 'Judo und SVC Rothrist', logo: '/images/clubs/rothrist.webp' },
          { name: 'JAC Wohlen', logo: '/images/clubs/jac-wohlen.webp' },
        ].map((club) => (
          <img
            src={club.logo}
            alt={club.name}
            title={club.name}
            class="h-12 lg:h-14 w-auto object-contain opacity-70 hover:opacity-100 transition-opacity"
          />
        ))}
      </div>
      <div class="mt-10 text-center">
        <a
          href="/vereine"
          class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 tracking-wide hover:text-brand-700 transition-colors group"
        >
          Alle Vereine ansehen
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- About / Der Verband -->
  <section class="py-20 lg:py-32">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-4">Der Verband</p>
        <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 leading-tight">
          Wir vertreten Judo und Ju-Jitsu im Aargau
        </h2>
        <p class="mt-8 text-stone-600 text-lg leading-relaxed">
          Der AJV ist die offizielle Vertretung aller Judo- und Ju-Jitsu-Vereine im Kanton Aargau.
          Als Mitglied des Schweizerischen Judo & Ju-Jitsu Verbands (SJV) fördern wir den Sport auf
          allen Ebenen — vom Breitensport bis zum Spitzensport.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-6">
          <a
            href="/verband"
            class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 tracking-wide hover:text-brand-700 transition-colors group"
          >
            Mehr über den Verband
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="/vorstand"
            class="inline-flex items-center gap-2 text-sm font-semibold text-brand-600 tracking-wide hover:text-brand-700 transition-colors group"
          >
            Vorstand
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
      </div>
      <div class="mt-16 grid grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
        {[
          { label: 'Respekt', desc: 'Achtung vor dem Gegenüber auf und neben der Matte' },
          { label: 'Disziplin', desc: 'Konsequentes Training und Selbstbeherrschung' },
          { label: 'Mut', desc: 'Herausforderungen annehmen und über sich hinauswachsen' },
          { label: 'Freundschaft', desc: 'Gemeinsam wachsen und einander unterstützen' },
        ].map((v) => (
          <div class="bg-white border border-stone-200 rounded-lg p-5 lg:p-6 card-hover">
            <div class="w-8 h-0.5 bg-brand-500 mb-4 rounded-full"></div>
            <h3 class="font-display text-lg lg:text-xl font-bold text-stone-900">{v.label}</h3>
            <p class="mt-2 text-sm text-stone-500 leading-relaxed">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Kontakt CTA -->
  <section class="relative bg-brand-700 text-white hero-overlay py-16 lg:py-20 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="font-display text-2xl lg:text-3xl font-bold">Fragen zum AJV?</h2>
        <p class="mt-2 text-brand-200 leading-relaxed">Wir helfen gerne weiter — melde dich bei uns.</p>
      </div>
      <a
        href="/kontakt"
        class="flex-shrink-0 px-6 py-3 bg-white text-brand-700 text-sm font-semibold tracking-wide rounded-md hover:bg-stone-100 transition-colors"
      >
        Kontakt aufnehmen
      </a>
    </div>
  </section>

</BaseLayout>
