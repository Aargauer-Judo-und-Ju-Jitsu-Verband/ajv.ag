---
import BaseLayout from '../layouts/BaseLayout.astro';

const board = [
  { role: 'Präsident', name: 'Andreas Schmid', image: '/images/board/andreas-schmid-portrait.webp' },
  { role: 'Vizepräsident', name: 'Philippe Kölliker', image: '/images/board/philippe-koelliker-portrait.webp' },
  { role: 'Aktuarin', name: 'Rahel Kuhn', image: '/images/board/rahel-kuhn-portrait.webp' },
  { role: 'Vertreterin Kantonalkader', name: 'Jenny Gal', image: '/images/board/jenny-gal-portrait.webp' },
  { role: 'Kassier', name: 'René Siegrist', image: '/images/board/rene-siegrist-portrait.webp' },
];

const honorary = [
  { name: 'Peter Fischer' },
  { name: 'Peter Walter' },
  { name: 'Michael Weissbarth', since: 2025 },
  { name: 'Matthias Marti', since: 2025 },
];
---

<BaseLayout title="Vorstand" description="Der Vorstand des Aargauer Judo und Ju-Jitsu Verbands – Präsidium, Finanzen, Sport und Nachwuchsförderung. Lerne die Personen hinter dem AJV kennen.">
  <!-- Hero -->
  <section class="relative bg-brand-50 text-stone-900 py-20 lg:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="animate-fade-up text-brand-600 text-xs font-semibold uppercase tracking-[0.3em] mb-6">
        Führung
      </p>
      <h1 class="animate-fade-up stagger-1 font-display font-extrabold text-4xl sm:text-5xl lg:text-7xl leading-[0.95] tracking-tight text-stone-900">
        Vorstand
      </h1>
      <p class="animate-fade-up stagger-2 mt-6 text-lg text-stone-600 max-w-2xl leading-relaxed">
        Der Vorstand des Aargauer Judo und Ju-Jitsu Verbands setzt sich aus engagierten
        Persönlichkeiten zusammen, die den Verband mit Leidenschaft und Expertise führen.
      </p>
    </div>
  </section>

  <!-- Board Members -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {board.map((member, i) => (
          <div class={`group flex flex-col bg-white border border-stone-200 rounded-lg overflow-hidden card-hover animate-fade-up stagger-${Math.min(i + 1, 4)}`}>
            <div class="aspect-[4/5] overflow-hidden bg-stone-200">
              <img
                src={member.image}
                alt={`${member.name} – ${member.role} des AJV`}
                width="700"
                height="875"
                loading="lazy"
                class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-6">
              <p class="text-xs font-semibold text-brand-500 uppercase tracking-[0.3em]">{member.role}</p>
              <h3 class="mt-2 font-display font-semibold text-xl lg:text-2xl text-stone-900">{member.name}</h3>
            </div>
          </div>
        ))}
      </div>

      <!-- Ehrenmitglieder -->
      <div class="mt-20">
        <p class="text-xs font-semibold text-brand-500 uppercase tracking-[0.3em] mb-3">Verdienste</p>
        <h2 class="font-display font-bold text-3xl lg:text-4xl text-stone-900 mb-8 heading-accent">Ehrenmitglieder</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {honorary.map((member) => (
            <div class="bg-stone-100 border border-stone-200 rounded-lg p-6">
              <h3 class="font-display font-semibold text-xl text-stone-900">{member.name}</h3>
              <p class="mt-1 text-sm text-stone-400">
                {member.since ? `Ehrenmitglied seit ${member.since}` : 'Ehrenmitglied'}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- Contact CTA -->
      <div class="mt-20 relative bg-brand-700 text-white hero-overlay rounded-lg p-10 lg:p-14 overflow-hidden">
        <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-bl from-brand-300/10 to-transparent pointer-events-none"></div>
        <div class="text-center">
          <h3 class="font-display font-semibold text-2xl lg:text-3xl">Kontakt zum Vorstand</h3>
          <p class="mt-3 text-brand-200 max-w-lg mx-auto">
            Bei Fragen oder sonstigen Anliegen stehen wir sehr gerne zur Verfügung.
          </p>
          <a
            href="/kontakt"
            class="inline-block mt-6 px-6 py-3 rounded-md bg-brand-400 text-stone-900 text-sm font-semibold tracking-wide hover:bg-brand-300 transition-colors"
          >
            Kontakt aufnehmen
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
