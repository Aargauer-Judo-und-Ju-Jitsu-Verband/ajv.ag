---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Impressum" description="Impressum des Aargauer Judo und Ju-Jitsu Verbands (AJV): Herausgeber, Adresse, Rechtsform, UID CHE-131.772.139 und Vereinszweck.">
  <!-- Hero -->
  <section class="relative bg-brand-50 text-stone-900 py-20 lg:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="animate-fade-up text-brand-600 text-xs font-semibold uppercase tracking-[0.3em] mb-6">
        Impressum
      </p>
      <h1 class="animate-fade-up stagger-1 font-display font-extrabold text-4xl sm:text-5xl lg:text-7xl leading-[0.95] tracking-tight text-stone-900">
        Impressum
      </h1>
      <p class="animate-fade-up stagger-2 mt-6 text-lg text-stone-600 max-w-2xl leading-relaxed">
        Angaben zum Aargauer Judo und Ju-Jitsu Verband (AJV).
      </p>
    </div>
  </section>

  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-6">
        <div class="bg-white border border-stone-200 rounded-lg p-6 lg:p-8">
          <h2 class="font-display text-xl font-semibold text-stone-900 mb-2">Herausgeber</h2>
          <p class="text-stone-600 leading-relaxed">
            Aargauer Judo und Ju-Jitsu Verband (AJV)<br />
            c/o Rahel Kuhn (Aktuarin)<br />
            Kirchenfeldstrasse 26<br />
            5630 Muri<br />
            E-Mail:
            <a href="mailto:info@ajv.ag" class="text-brand-600 hover:text-brand-700 transition-colors font-semibold">info@ajv.ag</a>
          </p>
        </div>

        <div class="bg-white border border-stone-200 rounded-lg p-6 lg:p-8">
          <h2 class="font-display text-xl font-semibold text-stone-900 mb-2">Rechtsform</h2>
          <p class="text-stone-600 leading-relaxed">
            Verein im Sinne von Art. 60 ff. ZGB, politisch und konfessionell neutral.
          </p>
        </div>

        <div class="bg-white border border-stone-200 rounded-lg p-6 lg:p-8">
          <h2 class="font-display text-xl font-semibold text-stone-900 mb-2">UID</h2>
          <p class="text-stone-600 leading-relaxed">CHE-131.772.139</p>
        </div>

        <div class="bg-white border border-stone-200 rounded-lg p-6 lg:p-8">
          <h2 class="font-display text-xl font-semibold text-stone-900 mb-2">Vereinszweck</h2>
          <p class="text-stone-600 leading-relaxed">
            Der AJV pflegt, fördert und verbreitet Kodokan-Judo und Ju-Jitsu im Kanton Aargau und vertritt die
            Interessen seiner Mitglieder, der Aargauer Judo- und Ju-Jitsu-Clubs, gegenüber kantonalen Institutionen
            und Behörden. Er ist Dachverband der Mitgliedclubs und Mitglied des Schweizerischen Judo und Ju-Jitsu
            Verbandes (SJV).
          </p>
          <a
            href="/downloads/AJV-Statuten-April-2025.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block mt-4 text-sm font-semibold text-brand-600 hover:text-brand-700 transition-colors"
          >
            AJV Statuten (PDF)
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
