---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Veranstaltungen" description="Wettkämpfe, Trainings und Events des AJV">
  <!-- Hero -->
  <section class="relative bg-brand-700 text-white hero-overlay py-20 lg:py-28 overflow-hidden">
    <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-bl from-brand-300/10 to-transparent pointer-events-none"></div>
    <div class="absolute top-0 left-1/2 w-px h-full bg-gradient-to-b from-brand-400/20 via-transparent to-transparent"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="animate-fade-up text-brand-200 text-xs font-semibold uppercase tracking-[0.3em] mb-6">
        Kalender
      </p>
      <h1 class="animate-fade-up stagger-1 font-display font-extrabold text-4xl sm:text-5xl lg:text-7xl leading-[0.95] tracking-tight">
        Veranstaltungen
      </h1>
      <p class="animate-fade-up stagger-2 mt-6 text-lg text-brand-200 max-w-2xl leading-relaxed">
        Wettkämpfe, Kurse und Trainings — alle Termine auf einen Blick.
      </p>
    </div>
  </section>

  <!-- Calendar -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white border border-stone-200 rounded-lg p-4 shadow-lg">
        <iframe
          src="https://calendar.google.com/calendar/embed?height=600&wkst=2&ctz=Europe%2FZurich&showPrint=0&title=AJV%20Agenda&mode=AGENDA&showTitle=0&showTz=0&showCalendars=0&showDate=0&src=Y185Njk1ZjZlOWY4YjA0NTYzZDczMjA1ZTNhZTM3OTAxNjNmMDQ4NTA5NzJhNjY4MDUwNzQyODQ0YjY1ZGY4ZmI5QGdyb3VwLmNhbGVuZGFyLmdvb2dsZS5jb20&color=%234285f4"
          style="border-width: 0"
          width="100%"
          height="600"
          frameborder="0"
          scrolling="no"
          class="w-full"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
