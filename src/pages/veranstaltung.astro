---
import BaseLayout from '../layouts/BaseLayout.astro';
// Detail view for a single event. The event id comes from the URL (?id=…) and
// is loaded client-side from /api/events?id=…, so it stays dynamic (no rebuild).
// noindex: these are query-parameterised, client-rendered pages — not for search.
---

<BaseLayout title="Veranstaltung" description="Details zu einer Veranstaltung des Aargauer Judo und Ju-Jitsu Verbands." noindex>
  <section class="bg-brand-700 text-white py-12 lg:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/veranstaltungen"
         class="inline-flex items-center gap-1.5 text-sm text-brand-200 hover:text-white transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        Alle Veranstaltungen
      </a>
    </div>
  </section>

  <section class="py-12 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div id="event-detail">
        <div class="flex items-center justify-center py-16">
          <div class="flex items-center gap-3 text-stone-400">
            <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
            </svg>
            <span class="text-sm">Veranstaltung wird geladen…</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    type AjvEvent,
    MONTHS_LONG,
    WEEKDAYS_LONG,
    startDate,
    isMultiDayAllDay,
    ymd,
    formatTimeInfo,
    addToGCalUrl,
    imageFor,
  } from '../lib/eventFormat';

  const root = document.getElementById('event-detail')!;

  function notFound(msg: string) {
    root.innerHTML = `
      <div class="text-center py-12">
        <p class="text-stone-500">${msg}</p>
        <a href="/veranstaltungen" class="inline-flex items-center gap-1.5 mt-4 text-sm font-semibold text-brand-600 hover:text-brand-700">
          Zur Veranstaltungsübersicht &rarr;
        </a>
      </div>`;
  }

  function fullDate(ev: AjvEvent): string {
    const s = startDate(ev);
    const base = `${WEEKDAYS_LONG[s.getDay()]}, ${s.getDate()}. ${MONTHS_LONG[s.getMonth()]} ${s.getFullYear()}`;
    if (ev.isAllDay && isMultiDayAllDay(ev)) {
      const [ey, em, ed] = ymd(ev.endRaw); // exclusive → last day is end - 1
      const last = new Date(ey, em - 1, ed - 1);
      return `${s.getDate()}. ${MONTHS_LONG[s.getMonth()]} – ${last.getDate()}. ${MONTHS_LONG[last.getMonth()]} ${last.getFullYear()}`;
    }
    return base;
  }

  function render(ev: AjvEvent) {
    document.title = `${ev.title} | Aargauer Judo und Ju-Jitsu Verband`;

    const canceled = ev.status === 'canceled';
    const color = ev.calendarColor || '#2A57C5';
    const img = imageFor(ev);
    const time = formatTimeInfo(ev);
    const timeSuffix = ev.isAllDay && !isMultiDayAllDay(ev) ? '' : (time ? ` · ${time}` : '');

    const mapsLink = ev.place
      ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(ev.place)}`
      : '';

    const signup = ev.signup
      ? `<div class="mt-6 rounded-lg border border-stone-200 bg-stone-50 p-4">
           <p class="text-sm font-semibold text-stone-700">Anmeldung</p>
           <p class="mt-1 text-sm text-stone-500">${
             ev.signup.max ? `${ev.signup.count} von ${ev.signup.max} Plätzen belegt` : `${ev.signup.count} Anmeldungen`
           }${ev.signup.until ? ` · Anmeldeschluss: ${new Date(ev.signup.until).toLocaleDateString('de-CH')}` : ''}</p>
         </div>`
      : '';

    root.innerHTML = `
      <article>
        ${img ? `<img src="${img}" alt="" class="w-full h-56 sm:h-72 object-cover rounded-xl mb-8" />` : ''}
        <div class="flex flex-wrap items-center gap-2 mb-3">
          ${ev.calendar ? `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold" style="color:${color};background:${color}1a"><span class="w-1.5 h-1.5 rounded-full" style="background:${color}"></span>${ev.calendar}</span>` : ''}
          ${canceled ? `<span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold text-red-600 bg-red-50">Abgesagt</span>` : ''}
        </div>

        <h1 class="font-display font-extrabold text-3xl sm:text-4xl text-stone-900 leading-tight break-words ${canceled ? 'line-through text-stone-400' : ''}">${ev.title}</h1>

        <div class="mt-5 space-y-2 text-stone-600">
          <p class="flex items-center gap-2.5">
            <svg class="w-5 h-5 text-brand-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span class="font-medium">${fullDate(ev)}${timeSuffix}</span>
          </p>
          ${ev.place ? `<p class="flex items-center gap-2.5">
            <svg class="w-5 h-5 text-brand-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <a href="${mapsLink}" target="_blank" rel="noopener noreferrer" class="hover:text-brand-700 underline underline-offset-2 decoration-stone-300">${ev.place}</a>
          </p>` : ''}
        </div>

        ${ev.descriptionHtml ? `<div class="mt-6 text-stone-700 leading-relaxed prose-links break-words">${ev.descriptionHtml}</div>` : ''}

        ${signup}

        <div class="mt-8 pt-6 border-t border-stone-200">
          <a href="${addToGCalUrl(ev)}" target="_blank" rel="noopener noreferrer"
             class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Zum Kalender hinzufügen
          </a>
        </div>
      </article>`;
  }

  async function load() {
    const id = new URLSearchParams(location.search).get('id');
    if (!id || !/^\d+$/.test(id)) {
      notFound('Keine gültige Veranstaltung angegeben.');
      return;
    }
    try {
      const res = await fetch(`/api/events?id=${encodeURIComponent(id)}`);
      if (res.status === 404) {
        notFound('Diese Veranstaltung wurde nicht gefunden.');
        return;
      }
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      if (!data.event) {
        notFound('Diese Veranstaltung wurde nicht gefunden.');
        return;
      }
      render(data.event as AjvEvent);
    } catch (e) {
      console.error('Failed to load event:', e);
      notFound('Die Veranstaltung konnte nicht geladen werden.');
    }
  }

  load();
</script>

<style>
  .prose-links :global(a) {
    color: var(--color-brand-600);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere; /* break long bare URLs instead of overflowing */
  }
  .prose-links :global(a:hover) {
    color: var(--color-brand-700);
  }
</style>
