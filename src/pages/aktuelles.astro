---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Aktuelles" description="Neuigkeiten vom Aargauer Judo und Ju-Jitsu Verband">
  <!-- Hero -->
  <section class="relative bg-brand-50 text-stone-900 py-20 lg:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="animate-fade-up text-brand-600 text-xs font-semibold uppercase tracking-[0.3em] mb-6">
        Neuigkeiten
      </p>
      <h1 class="animate-fade-up stagger-1 font-display font-extrabold text-4xl sm:text-5xl lg:text-7xl leading-[0.95] tracking-tight text-stone-900">
        Aktuelles
      </h1>
      <p class="animate-fade-up stagger-2 mt-6 text-lg text-stone-600 max-w-2xl leading-relaxed">
        Neuigkeiten, Berichte und Ankündigungen rund um den AJV.
      </p>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a href={`/aktuelles/${post.id}`} class="group">
            <article class="bg-white border border-stone-200 rounded-lg overflow-hidden h-full card-hover">
              {post.data.image && (
                <div class="aspect-[16/9] overflow-hidden bg-stone-100">
                  <Image
                    src={post.data.image}
                    alt={post.data.imageAlt || post.data.title}
                    width={640}
                    height={360}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </div>
              )}
              <div class="p-6 lg:p-7">
                {post.data.category && (
                  <span class="inline-block px-3 py-1 bg-brand-50 text-brand-600 text-xs font-semibold uppercase tracking-wider mb-4 rounded">
                    {post.data.category}
                  </span>
                )}
                <time class="text-xs text-stone-400 uppercase tracking-wider" datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('de-CH', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
                <h2 class="mt-3 font-display font-bold text-xl lg:text-2xl text-stone-900 group-hover:text-brand-500 transition-colors leading-snug">
                  {post.data.title}
                </h2>
                <p class="mt-3 text-sm text-stone-500 leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>
                <span class="inline-flex items-center gap-1 mt-5 text-xs font-semibold text-stone-500 uppercase tracking-wider group-hover:text-brand-500 transition-colors">
                  Weiterlesen
                  <svg class="w-3 h-3 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </span>
              </div>
            </article>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
