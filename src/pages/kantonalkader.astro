---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import kaderWeekend from '../assets/images/kantonalkader/kader-weekend-2022.jpg';

type Status = true | false | 'ersatz';
interface TrainingRow {
  date: string;   // 'TT.MM.'
  training: Status;
  note: string;
}

// ---------------------------------------------------------------------------
// Stützpunkttrainings-Termine
//
// Quelle: ein als CSV veröffentlichtes Google Sheet (Spalten: Datum, Status,
// Bemerkung). Die URL steht in der Umgebungsvariable PUBLIC_KADER_SHEET_CSV.
// Die Daten werden zur BUILD-ZEIT gelesen (kein CORS, im statischen HTML, gut
// für SEO). Aktualisierung: Sheet bearbeiten → nächtlicher Rebuild übernimmt
// die Änderung (siehe docs/kantonalkader-termine.md).
//
// Erwartetes CSV-Format (erste Zeile = Kopfzeile):
//   Datum,Status,Bemerkung
//   10/1/2026,kein Training,
//   17/1/2026,Training,
//   7/6/2026,Ersatz,Kantonalkadertraining Rothrist
//
// Datum: Tag vor Monat, diverse Schreibweisen (10/1/2026, 10.01.2026, 10.01.,
// ISO 2026-01-10). Status: "Training" | "kein Training" | "Ersatz"
// (Gross-/Kleinschreibung egal).
// Kann das Sheet nicht geladen werden (URL fehlt oder Sheet nicht erreichbar),
// bricht der Build bewusst ab — Netlify behält dann den letzten erfolgreichen
// Deploy. Es gibt keinen im Code hinterlegten Reserveplan.
// ---------------------------------------------------------------------------

// Minimaler CSV-Parser (verarbeitet "..."-gequotete Felder mit Kommas/Zeilenumbrüchen).
function parseCsv(text: string): string[][] {
  const rows: string[][] = [];
  let row: string[] = [];
  let field = '';
  let inQuotes = false;
  const t = text.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
  for (let i = 0; i < t.length; i++) {
    const c = t[i];
    if (inQuotes) {
      if (c === '"') {
        if (t[i + 1] === '"') { field += '"'; i++; }
        else inQuotes = false;
      } else field += c;
    } else if (c === '"') {
      inQuotes = true;
    } else if (c === ',') {
      row.push(field); field = '';
    } else if (c === '\n') {
      row.push(field); field = '';
      if (row.some((f) => f.trim() !== '')) rows.push(row);
      row = [];
    } else field += c;
  }
  if (field !== '' || row.length) {
    row.push(field);
    if (row.some((f) => f.trim() !== '')) rows.push(row);
  }
  return rows;
}

function normalizeStatus(raw: string): Status {
  const v = raw.trim().toLowerCase();
  if (v.includes('ersatz')) return 'ersatz';
  if (v.startsWith('kein') || v === 'nein' || v === '' || v === '-') return false;
  if (v.includes('training') || v === 'ja' || v === 'x') return true;
  return false;
}

const pad2 = (n: number): string => String(n).padStart(2, '0');

// Datum aus dem Sheet parsen — tolerant gegenüber verschiedenen Schreibweisen:
// 10/1/2026, 10.01.2026, 10.01., 10-1-26 (Tag vor Monat, europäisch) sowie
// ISO 2026-01-10. Liefert Tag/Monat/Jahr oder null, wenn nichts erkennbar ist.
function parseDate(raw: string): { day: number; month: number; year?: number } | null {
  const s = raw.trim();
  let m = s.match(/^(\d{4})[-.\/](\d{1,2})[-.\/](\d{1,2})/); // ISO: Jahr zuerst
  if (m) return { year: +m[1], month: +m[2], day: +m[3] };
  m = s.match(/^(\d{1,2})[.\/-](\d{1,2})(?:[.\/-](\d{2,4}))?/); // Tag.Monat.Jahr
  if (m) {
    let year = m[3] ? +m[3] : undefined;
    if (year !== undefined && year < 100) year += 2000;
    return { day: +m[1], month: +m[2], year };
  }
  return null;
}

async function loadSchedule(): Promise<{ h1: TrainingRow[]; h2: TrainingRow[]; year: number }> {
  const url = import.meta.env.PUBLIC_KADER_SHEET_CSV;
  if (!url) {
    throw new Error('PUBLIC_KADER_SHEET_CSV ist nicht gesetzt — siehe docs/kantonalkader-termine.md');
  }

  const res = await fetch(url);
  if (!res.ok) throw new Error(`Kader-Sheet nicht erreichbar: HTTP ${res.status}`);
  const rows = parseCsv(await res.text());
  if (rows.length < 2) throw new Error('Kader-Sheet leer');

  // Spaltenindizes aus der Kopfzeile bestimmen (sonst positionell 0/1/2).
  const header = rows[0].map((h) => h.trim().toLowerCase());
  let di = header.findIndex((h) => h.startsWith('datum'));
  let si = header.findIndex((h) => h.startsWith('status'));
  let ni = header.findIndex((h) => h.startsWith('bemerk'));
  if (di === -1 && si === -1) { di = 0; si = 1; ni = 2; }
  if (di === -1) di = 0;
  if (si === -1) si = 1;
  if (ni === -1) ni = 2;

  const h1: TrainingRow[] = [];
  const h2: TrainingRow[] = [];
  const years: number[] = [];

  for (const r of rows.slice(1)) {
    const parsed = parseDate(r[di] || '');
    if (!parsed) continue;
    const row: TrainingRow = {
      date: `${pad2(parsed.day)}.${pad2(parsed.month)}.`,
      training: normalizeStatus(r[si] || ''),
      note: (r[ni] || '').trim(),
    };
    if (parsed.year) years.push(parsed.year);
    (parsed.month <= 6 ? h1 : h2).push(row);
  }

  if (h1.length === 0 && h2.length === 0) {
    throw new Error('Kader-Sheet enthält keine gültigen Zeilen');
  }

  // Saison-Jahr aus den Daten ableiten (häufigstes Jahr), sonst Build-Jahr.
  const year = years.length
    ? years.sort((a, b) =>
        years.filter((y) => y === b).length - years.filter((y) => y === a).length,
      )[0]
    : new Date().getFullYear();

  return { h1, h2, year };
}

const { h1: stpH1, h2: stpH2, year: seasonYear } = await loadSchedule();
const standDate = new Date().toLocaleDateString('de-CH', { day: '2-digit', month: '2-digit', year: 'numeric' });
---

<BaseLayout title="Kantonalkader" description="Das Judo-Kantonalkader Aargau – wöchentliches Stützpunkttraining für junge Judoka der Kategorien U11, U13 und U15. Der Weg in den nationalen Leistungssport.">
  <!-- Hero -->
  <section class="relative bg-brand-700 text-white hero-overlay py-20 lg:py-28 overflow-hidden">
    <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-bl from-brand-300/10 to-transparent pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="animate-fade-up text-brand-200 text-xs font-semibold uppercase tracking-[0.3em] mb-6">
        Nachwuchsförderung
      </p>
      <h1 class="animate-fade-up stagger-1 font-display font-extrabold text-4xl sm:text-5xl lg:text-7xl leading-[0.95] tracking-tight">
        Kantonalkader Judo
      </h1>
      <p class="animate-fade-up stagger-2 mt-6 text-lg text-brand-200 max-w-2xl leading-relaxed">
        Willkommen beim Aargauer Kantonalkader — das zentrale Fördergefäss für junge Judoka der Kategorien U11, U13 und U15.
      </p>
    </div>
  </section>

  <!-- Intro with photo -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div>
          <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">Über das Kader</p>
          <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">Das Aargauer Kantonalkader</h2>
          <div class="mt-6 space-y-4 text-lg text-stone-500 leading-relaxed">
            <p>
              Die Kantonalkader sind ein Element der Judo-Nachwuchsförderung des SJV (Schweizerischen Judo & Ju-Jitsu Verbandes). Sie sind das zentrale Fördergefäss für den Einstieg in den Leistungssport und umfassen Judokas vom 9. bis 14. Lebensjahr.
            </p>
            <p>
              Sie bilden das Fundament der Kaderstruktur und stellen die erste Stufe des leistungsförderlichen Aufbaus dar.
            </p>
          </div>
        </div>
        <div class="relative">
          <Image
            src={kaderWeekend}
            alt="Kantonalkader Judo Aargau — Gruppenfoto"
            class="rounded-lg shadow-lg w-full"
            widths={[400, 800]}
            sizes="(max-width: 1024px) 100vw, 50vw"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Ziele -->
  <section class="py-20 lg:py-28 bg-stone-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">Ziele</p>
        <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">Was wir anstreben</h2>
      </div>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { title: 'Vereine stärken', text: 'Unterstützen der Vereine des AJV in ihrer Nachwuchsarbeit.' },
          { title: 'Nachhaltige Ausbildung', text: 'Nachhaltige Ausbildung für Nachwuchsjudoka im Wettkampfbereich.' },
          { title: 'SJV U18 Kader', text: 'Vorbereitung für das SJV U18 Kader auf nationaler Ebene.' },
          { title: 'NLZ Academy', text: 'Vorbereitung für das Regionale Leistungszentrum «NLZ Academy».' },
          { title: 'Talentsichtung', text: 'Sichtung junger Nachwuchsjudoka für die Swiss Olympic Talentcards.' },
        ].map((item) => (
          <div class="bg-white border border-stone-200 rounded-lg p-6 card-hover">
            <div class="w-8 h-0.5 bg-brand-500 rounded-full mb-4"></div>
            <h3 class="font-display text-lg font-semibold text-stone-900 mb-2">{item.title}</h3>
            <p class="text-stone-500 leading-relaxed">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Kadermitglieder -->
  <section class="py-20 lg:py-28">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">Mitmachen</p>
      <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">Kadermitglieder</h2>
      <div class="mt-6 space-y-4 text-lg text-stone-500 leading-relaxed">
        <p>
          Teilnahmeberechtigt sind alle Judoka U15 (Schüler A) und U13 (Schüler B) sowie die älteste U11 (Schüler C), die Mitglied sind in einem Verein des AJV.
        </p>
        <p>
          Voraussetzungen:
        </p>
        <ul class="space-y-3 mt-2">
          <li class="flex items-start gap-3">
            <div class="w-1.5 h-1.5 bg-brand-400 mt-2.5 shrink-0"></div>
            <span>Mindestens Gelbgurt</span>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-1.5 h-1.5 bg-brand-400 mt-2.5 shrink-0"></div>
            <span>Spass am Judo und am Kämpfen</span>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-1.5 h-1.5 bg-brand-400 mt-2.5 shrink-0"></div>
            <span>Bereitschaft, 1 Mal pro Woche zusätzlich zu trainieren</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Stützpunkttrainings -->
  <section id="stuetzpunkttrainings" class="py-20 lg:py-28 bg-stone-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">Wöchentlich</p>
        <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">Stützpunkttrainings {seasonYear}</h2>
        <div class="mt-6 space-y-4 text-lg text-stone-500 leading-relaxed">
          <p>
            Die Stützpunkttrainings finden jeweils am <strong class="text-stone-700">Samstag Morgen, 10:00–12:00 Uhr</strong> statt, im Dojo des Nationalen Leistungszentrums in Brugg/Windisch.
          </p>
          <p>
            In diesem Wettkampftraining stehen Technik, Randori und Konditionstraining im Vordergrund.
          </p>
          <p>
            Das Training richtet sich an die Alterskategorien U11, U13, U15 ab Gelbgurt und steht <strong class="text-stone-700">allen Aargauer Judoka offen</strong>.
          </p>
          <p>
            Teilnahme ist jederzeit ohne Voranmeldung möglich.
          </p>
        </div>
        <div class="mt-8 bg-white border border-stone-200 rounded-lg p-6">
          <h3 class="font-display font-semibold text-stone-900 mb-2">Trainingsort</h3>
          <p class="text-stone-500">
            Sportausbildungszentrum Mülimatt<br />
            Gaswerkstrasse 2<br />
            5210 Windisch (AG)
          </p>
        </div>
      </div>

      <!-- Trainingstabellen -->
      <div class="mt-12 grid md:grid-cols-2 gap-8">
        <div class="bg-white border border-stone-200 rounded-lg overflow-hidden card-hover">
          <div class="px-6 py-4 border-b border-stone-200 bg-stone-50">
            <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] text-center">Januar – Juni {seasonYear}</p>
          </div>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-stone-200 text-left">
                <th class="px-4 py-2 font-semibold text-stone-700">Datum</th>
                <th class="px-4 py-2 font-semibold text-stone-700">Status</th>
                <th class="px-4 py-2 font-semibold text-stone-700 hidden sm:table-cell">Bemerkung</th>
              </tr>
            </thead>
            <tbody>
              {stpH1.map((row) => (
                <tr class:list={[
                  'border-b border-stone-100',
                  row.training === true ? '' : row.training === 'ersatz' ? 'bg-amber-50' : 'bg-stone-50 text-stone-400',
                ]}>
                  <td class="px-4 py-1.5 tabular-nums">{row.date}</td>
                  <td class="px-4 py-1.5">
                    {row.training === true ? (
                      <span class="inline-flex items-center gap-1 text-green-700 font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Training
                      </span>
                    ) : row.training === 'ersatz' ? (
                      <span class="inline-flex items-center gap-1 text-amber-700 font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Ersatz
                      </span>
                    ) : (
                      <span class="text-stone-400">kein Training</span>
                    )}
                  </td>
                  <td class="px-4 py-1.5 text-stone-400 hidden sm:table-cell">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="bg-white border border-stone-200 rounded-lg overflow-hidden card-hover">
          <div class="px-6 py-4 border-b border-stone-200 bg-stone-50">
            <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] text-center">Juli – Dezember {seasonYear}</p>
          </div>
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-stone-200 text-left">
                <th class="px-4 py-2 font-semibold text-stone-700">Datum</th>
                <th class="px-4 py-2 font-semibold text-stone-700">Status</th>
                <th class="px-4 py-2 font-semibold text-stone-700 hidden sm:table-cell">Bemerkung</th>
              </tr>
            </thead>
            <tbody>
              {stpH2.map((row) => (
                <tr class:list={[
                  'border-b border-stone-100',
                  row.training === true ? '' : row.training === 'ersatz' ? 'bg-amber-50' : 'bg-stone-50 text-stone-400',
                ]}>
                  <td class="px-4 py-1.5 tabular-nums">{row.date}</td>
                  <td class="px-4 py-1.5">
                    {row.training === true ? (
                      <span class="inline-flex items-center gap-1 text-green-700 font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>Training
                      </span>
                    ) : row.training === 'ersatz' ? (
                      <span class="inline-flex items-center gap-1 text-amber-700 font-medium">
                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span>Ersatz
                      </span>
                    ) : (
                      <span class="text-stone-400">kein Training</span>
                    )}
                  </td>
                  <td class="px-4 py-1.5 text-stone-400 hidden sm:table-cell">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="mt-4 text-xs text-stone-400 text-right">Stand: {standDate}</p>
    </div>
  </section>


  <!-- Ranking Turniere -->
  <section class="py-20 lg:py-28 bg-stone-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">Wettkampf</p>
      <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">Ranking Turniere</h2>
      <div class="mt-6 space-y-4 text-lg text-stone-500 leading-relaxed">
        <p>
          Die Nationalmannschaft U15 besucht jährlich 2 internationale Turniere. Man kann sich mit sehr guten Resultaten an den Rankingturnieren für diese Massnahmen qualifizieren.
        </p>
        <p>
          Nur Judoka der Alterskategorie Schüler A können sich für diese Turniere selektieren. Allfällige Vorbereitungsmassnahmen sind obligatorisch.
        </p>
        <p>
          An den Ranking Turnieren können Judoka mit dem ältesten Schüler A Jahrgang auch bei den U18 starten und sich eventuell für die Schweizermeisterschaften U18 qualifizieren.
        </p>
      </div>
    </div>
  </section>

  <!-- Probetraining CTA -->
  <section id="probetraining" class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative bg-brand-700 text-white hero-overlay rounded-lg p-10 lg:p-16 overflow-hidden">
        <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-bl from-brand-300/10 to-transparent pointer-events-none"></div>
        <div class="relative max-w-2xl">
          <p class="text-brand-200 text-xs font-semibold uppercase tracking-[0.3em] mb-4">Schnuppertraining</p>
          <h2 class="font-display text-3xl lg:text-4xl font-bold">Probetraining machen</h2>
          <p class="mt-4 text-brand-200 text-lg leading-relaxed">
            Alle interessierten Judoka zwischen 9 und 14 Jahren können ein Probetraining besuchen. Voraussetzung: viel Spass am Kämpfen!
          </p>
          <p class="mt-6 text-white leading-relaxed">
            Einfach eine E-Mail an <a href="mailto:kantonalkader@ajv.ag" class="underline underline-offset-4 hover:text-brand-200 transition-colors font-semibold">kantonalkader@ajv.ag</a> mit folgenden Angaben:
          </p>
          <ul class="mt-4 grid sm:grid-cols-2 gap-x-8 gap-y-2 text-brand-100">
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              Name, Nachname
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              Geburtsdatum
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              Gürtelfarbe
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              Aktuelles Gewicht
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              Club & Name Trainer
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              SJV Budopass Nr.
            </li>
            <li class="flex items-center gap-2">
              <svg class="w-4 h-4 text-brand-300 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
              Telefonnummer
            </li>
          </ul>
          <a
            href="mailto:kantonalkader@ajv.ag?subject=Probetraining Kantonalkader"
            class="inline-block mt-8 px-6 py-3 bg-white text-brand-700 text-sm font-semibold rounded-md hover:bg-stone-100 transition-colors"
          >
            E-Mail senden
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- NLZ Academy -->
  <section id="nlz-academy" class="py-20 lg:py-28 bg-stone-100">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">Leistungssport</p>
      <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">NLZ Academy</h2>
      <div class="mt-6 space-y-4 text-lg text-stone-500 leading-relaxed">
        <p>
          Die NLZ Academy ist ein Regionales Leistungszentrum (RLZ), das Teil der Leistungssport-Struktur des SJV ist und teilweise im NLZ integriert ist.
        </p>
        <p>
          In diesem Fördergefäss trainieren Judoka, die sich für den Leistungssport entschieden haben, bis zu 6 Tagen pro Woche. Um diesen Trainingsumfang zu ermöglichen, besuchen die meisten eine Sportschule oder machen eine sportfreundliche Lehre.
        </p>
        <p>
          Ein Einstieg in die NLZ Academy ist ab Schüler A möglich.
        </p>
      </div>
      <a
        href="https://www.judocenter.ch"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 mt-6 text-sm font-semibold text-brand-600 tracking-wide hover:text-brand-700 transition-colors group"
