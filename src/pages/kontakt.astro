---
import BaseLayout from '../layouts/BaseLayout.astro';

const contacts = [
  {
    role: 'Präsident',
    name: 'Michael Weissbarth',
    image: '/images/board/michael-weissbarth.webp',
    email: 'info@ajv.ag',
    desc: 'Allgemeine Anfragen an den Verband',
  },
  {
    role: 'Kantonalkader',
    name: 'Jenny Gal',
    image: '/images/board/jenny-gal.webp',
    email: 'kantonalkader@gmail.com',
    desc: 'Stützpunkttraining, Probetraining, Kader-Fragen',
  },
];
---

<BaseLayout title="Kontakt" description="Kontaktiere den Aargauer Judo und Ju-Jitsu Verband">
  <!-- Hero -->
  <section class="relative bg-brand-50 text-stone-900 py-20 lg:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="animate-fade-up text-brand-600 text-xs font-semibold uppercase tracking-[0.3em] mb-6">
        Kontakt
      </p>
      <h1 class="animate-fade-up stagger-1 font-display font-extrabold text-4xl sm:text-5xl lg:text-7xl leading-[0.95] tracking-tight text-stone-900">
        Melde dich bei uns
      </h1>
      <p class="animate-fade-up stagger-2 mt-6 text-lg text-stone-600 max-w-2xl leading-relaxed">
        Wir freuen uns über deine Nachricht — ob Frage, Anregung oder Feedback.
      </p>
    </div>
  </section>

  <!-- Ansprechpersonen -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">Ansprechpersonen</p>
      <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">Direkter Kontakt</h2>
      <div class="mt-10 grid grid-cols-1 md:grid-cols-2 gap-6">
        {contacts.map((person) => (
          <div class="bg-white border border-stone-200 rounded-lg p-6 lg:p-8 card-hover">
            <div class="flex items-start gap-5">
              <div class="w-16 h-16 flex-shrink-0 overflow-hidden rounded-full bg-stone-200">
                <img
                  src={person.image}
                  alt={person.name}
                  class="w-full h-full object-cover"
                />
              </div>
              <div>
                <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.2em]">{person.role}</p>
                <h3 class="mt-1 font-display text-xl font-semibold text-stone-900">{person.name}</h3>
                <p class="mt-1 text-sm text-stone-500">{person.desc}</p>
                <a
                  href={`mailto:${person.email}`}
                  class="inline-flex items-center gap-2 mt-3 text-sm font-semibold text-brand-600 hover:text-brand-700 transition-colors"
                >
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  {person.email}
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Formular + Infos -->
  <section class="py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Formular -->
        <div>
          <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">Formular</p>
          <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">Nachricht senden</h2>
          <form class="mt-8 space-y-5" name="kontakt" method="POST" data-netlify="true">
            <input type="hidden" name="form-name" value="kontakt" />
            <div>
              <label for="name" class="block text-sm font-semibold text-stone-700 mb-2">Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-md bg-white border border-stone-200 text-stone-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-200 outline-none transition-colors"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-semibold text-stone-700 mb-2">E-Mail</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-md bg-white border border-stone-200 text-stone-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-200 outline-none transition-colors"
              />
            </div>
            <div>
              <label for="betreff" class="block text-sm font-semibold text-stone-700 mb-2">Betreff</label>
              <select
                id="betreff"
                name="betreff"
                class="w-full px-4 py-3 rounded-md bg-white border border-stone-200 text-stone-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-200 outline-none transition-colors"
              >
                <option value="Allgemeine Anfrage">Allgemeine Anfrage</option>
                <option value="Kantonalkader">Kantonalkader</option>
                <option value="Mitgliedschaft">Mitgliedschaft</option>
                <option value="Veranstaltungen">Veranstaltungen</option>
                <option value="Sonstiges">Sonstiges</option>
              </select>
            </div>
            <div>
              <label for="message" class="block text-sm font-semibold text-stone-700 mb-2">Nachricht</label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 rounded-md bg-white border border-stone-200 text-stone-900 focus:border-brand-500 focus:ring-1 focus:ring-brand-200 outline-none transition-colors resize-y"
              ></textarea>
            </div>
            <button
              type="submit"
              class="px-6 py-3 rounded-md bg-brand-500 text-white text-sm font-semibold tracking-wide hover:bg-brand-600 transition-colors"
            >
              Nachricht senden
            </button>
          </form>
        </div>

        <!-- Infos -->
        <div>
          <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">Verband</p>
          <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">Adresse & Links</h2>
          <div class="mt-8 space-y-8">
            <div class="bg-stone-50 border border-stone-200 rounded-lg p-6">
              <h3 class="font-display font-semibold text-stone-900 mb-2">Postadresse</h3>
              <p class="text-stone-500 leading-relaxed">
                Judo und Ju-Jitsu Verband Aargau<br />
                Landhausstrasse 7<br />
                4663 Aarburg
              </p>
            </div>
            <div class="bg-stone-50 border border-stone-200 rounded-lg p-6">
              <h3 class="font-display font-semibold text-stone-900 mb-2">E-Mail</h3>
              <a href="mailto:info@ajv.ag" class="text-brand-600 hover:text-brand-700 transition-colors font-semibold">
                info@ajv.ag
              </a>
            </div>
            <div class="bg-stone-50 border border-stone-200 rounded-lg p-6">
              <h3 class="font-display font-semibold text-stone-900 mb-3">Links</h3>
              <ul class="space-y-2.5">
                <li>
                  <a
                    href="https://www.youtube.com/@judoaargau"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 transition-colors"
                  >
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                    YouTube-Kanal
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.sjv.ch/"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    SJV — Schweizerischer Judo & Ju-Jitsu Verband
                  </a>
                </li>
                <li>
                  <a
                    href="https://www.judoaargau.ch/fileadmin/aargauer-judo-verband/downloads/AJV_Statuten.pdf"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-sm text-brand-600 hover:text-brand-700 transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    AJV Statuten (PDF)
                  </a>
                </li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
