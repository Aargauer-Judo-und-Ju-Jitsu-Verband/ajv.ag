---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Der Verband" description="Der Aargauer Judo und Ju-Jitsu Verband (AJV) ist die offizielle Vertretung aller Judo- und Ju-Jitsu-Vereine im Kanton Aargau. Mitglied des Schweizerischen Judo & Ju-Jitsu Verbands (SJV) seit 1963.">
  <!-- Hero -->
  <section class="relative bg-brand-700 text-white hero-overlay py-20 lg:py-28 overflow-hidden">
    <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-bl from-brand-300/10 to-transparent pointer-events-none"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="animate-fade-up text-brand-200 text-xs font-semibold uppercase tracking-[0.3em] mb-6">
        Seit 1963
      </p>
      <h1 class="animate-fade-up stagger-1 font-display font-extrabold text-4xl sm:text-5xl lg:text-7xl leading-[0.95] tracking-tight">
        Unser Verband
      </h1>
      <p class="animate-fade-up stagger-2 mt-6 text-lg text-brand-200 max-w-2xl leading-relaxed">
        Der AJV vertritt und fördert Judo und Ju-Jitsu im Kanton Aargau seit 1963.
      </p>
    </div>
  </section>

  <!-- Content -->
  <section class="py-20 lg:py-32">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="space-y-8 text-lg text-stone-500 leading-relaxed">
        <p>
          Der Aargauer Judo und Ju-Jitsu Verband (AJV) ist die offizielle Vertretung seiner
          Mitgliedsvereine im Kanton Aargau. Als kantonaler Verband bildet der AJV das Bindeglied
          zwischen den lokalen Vereinen und dem Schweizerischen Judo und Ju-Jitsu Verband (SJV).
        </p>
        <p>
          Wir fördern Judo und Ju-Jitsu auf allen Wettkampfstufen — vom Nachwuchs bis zum
          Spitzensport. Dabei stehen die Werte Respekt, Disziplin, Mut und Freundschaft
          im Zentrum unserer Arbeit.
        </p>

        <div class="pt-4">
          <p class="text-xs font-semibold text-brand-500 uppercase tracking-[0.3em] mb-3">Aufgaben</p>
          <h2 class="font-display font-bold text-3xl lg:text-4xl text-stone-900 heading-accent">Unsere Aufgaben</h2>
        </div>
        <ul class="space-y-3 mt-6">
          <li class="flex items-start gap-3">
            <div class="w-1.5 h-1.5 bg-brand-400 mt-2.5 shrink-0"></div>
            <span>Organisation kantonaler Wettkämpfe und Meisterschaften</span>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-1.5 h-1.5 bg-brand-400 mt-2.5 shrink-0"></div>
            <span>Aus- und Weiterbildung von Trainern und Kampfrichtern</span>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-1.5 h-1.5 bg-brand-400 mt-2.5 shrink-0"></div>
            <span>Förderung des Nachwuchses</span>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-1.5 h-1.5 bg-brand-400 mt-2.5 shrink-0"></div>
            <span>Vertretung der Aargauer Vereine beim SJV</span>
          </li>
          <li class="flex items-start gap-3">
            <div class="w-1.5 h-1.5 bg-brand-400 mt-2.5 shrink-0"></div>
            <span>Koordination gemeinsamer Veranstaltungen</span>
          </li>
        </ul>

        <div class="pt-4">
          <p class="text-xs font-semibold text-brand-500 uppercase tracking-[0.3em] mb-3">Gemeinschaft</p>
          <h2 class="font-display font-bold text-3xl lg:text-4xl text-stone-900 heading-accent">Mitgliedschaft</h2>
        </div>
        <p>
          Dem AJV gehören 14 Vereine im Kanton Aargau an. Gemeinsam setzen wir uns für die
          Verbreitung und Qualität von Judo und Ju-Jitsu in der Region ein.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
