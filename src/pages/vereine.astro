---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClubMap from '../components/ClubMap.astro';
import { clubs } from '../data/clubs';

// Filter-Buttons, immer alle angezeigt (auch wenn noch kein Verein die Sportart hat)
const disciplines = ['Judo', 'Ju-Jitsu', 'Aikido', 'A-Judo'];
---

<BaseLayout title="Vereine" description="14 Judo- und Ju-Jitsu-Vereine im Kanton Aargau – mit Kontaktdaten, Standorten und Websites. Finde dein Dojo in Aarau, Baden, Brugg, Lenzburg, Wohlen und vielen weiteren Aargauer Gemeinden.">
  <!-- Hero -->
  <section class="relative bg-brand-50 text-stone-900 py-20 lg:py-28 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="animate-fade-up text-brand-600 text-xs font-semibold uppercase tracking-[0.3em] mb-6">
        14 Vereine
      </p>
      <h1 class="animate-fade-up stagger-1 font-display font-extrabold text-4xl sm:text-5xl lg:text-7xl leading-[0.95] tracking-tight text-stone-900">
        Unsere Vereine
      </h1>
      <p class="animate-fade-up stagger-2 mt-6 text-lg text-stone-600 max-w-2xl leading-relaxed">
        Der AJV vereint 14 Judo- und Ju-Jitsu-Vereine im Kanton Aargau.
        Finde den passenden Verein in deiner Nähe.
      </p>
    </div>
  </section>

  <!-- Map -->
  <section class="py-16 lg:py-20 bg-stone-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-semibold text-brand-500 uppercase tracking-[0.3em] mb-3">Standorte</p>
      <h2 class="font-display font-bold text-3xl lg:text-4xl text-stone-900 mb-8 heading-accent">Vereinsstandorte im Kanton Aargau</h2>
      <div id="club-filter" class="flex flex-col sm:flex-row sm:items-center gap-3 mb-4">
        <label class="relative flex-1 sm:max-w-sm">
          <span class="sr-only">Verein oder Ort suchen</span>
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M17 11a6 6 0 11-12 0 6 6 0 0112 0z" />
          </svg>
          <input id="club-search" type="search" placeholder="Verein oder Ort suchen…" autocomplete="off"
            class="w-full pl-9 pr-3 py-2.5 bg-white border border-stone-200 rounded-full text-sm text-stone-800 placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-brand-400 focus:border-transparent" />
        </label>
        <div class="flex flex-wrap gap-2" role="group" aria-label="Nach Sportart filtern">
          {disciplines.map((d) => (
            <button type="button" data-discipline={d} aria-pressed="false"
              class="discipline-chip px-4 py-2 rounded-full border border-stone-200 bg-white text-sm font-medium text-stone-600 hover:border-brand-400 transition-colors aria-pressed:bg-brand-500 aria-pressed:border-brand-500 aria-pressed:text-white">
              {d}
            </button>
          ))}
        </div>
        <p id="club-count" class="text-sm text-stone-500 sm:ml-auto" aria-live="polite"></p>
      </div>
      <div class="bg-white border border-stone-200 rounded-lg overflow-hidden shadow-lg">
        <ClubMap clubs={clubs} />
      </div>
    </div>
  </section>

  <!-- Club Cards -->
  <section class="py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p id="club-empty" class="hidden text-stone-500 mb-6">Kein Verein passt zu deiner Suche. <button type="button" id="club-reset" class="text-brand-600 underline">Filter zurücksetzen</button></p>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {clubs.map((club) => (
          <div class="club-card bg-white border border-stone-200 rounded-lg p-6 card-hover" data-name={club.name}
            data-search={[club.name, club.address, club.location, ...club.disciplines].filter(Boolean).join(' ').toLowerCase()}
            data-disciplines={club.disciplines.join('|')}>
            <div class="flex items-center gap-4 mb-4">
              <img src={club.logo} alt={club.name} class="w-12 h-12 object-contain" />
              <h3 class="font-display font-semibold text-xl text-stone-900">{club.name}</h3>
            </div>
            <div class="w-8 h-0.5 bg-brand-400 mb-4"></div>
            <div class="flex flex-wrap gap-1.5 mb-3">
              {club.disciplines.map((d) => (
                <span class="px-2 py-0.5 rounded-full bg-brand-50 text-brand-700 text-xs font-medium">{d}</span>
              ))}
            </div>
            <div class="space-y-2 text-sm text-stone-500">
              <p class="flex items-start gap-2">
                <svg class="w-4 h-4 shrink-0 text-stone-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span>
                  {club.address && <>{club.address}<br /></>}
                  {club.location}
                </span>
              </p>
              {club.phone && (
                <p class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <a href={`tel:${club.phone.replace(/\s/g, '')}`} class="hover:text-brand-500 transition-colors">{club.phone}</a>
                </p>
              )}
              {club.email && (
                <p class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                  <a href={`mailto:${club.email}`} class="hover:text-brand-500 transition-colors">{club.email}</a>
                </p>
              )}
              {club.website && (
                <p class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
                  </svg>
                  <a href={club.website} target="_blank" rel="noopener noreferrer" class="hover:text-brand-500 transition-colors">Website</a>
                </p>
              )}
              {club.news && (
                <p class="flex items-center gap-2">
                  <svg class="w-4 h-4 shrink-0 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
                  </svg>
                  <a href={club.news} target="_blank" rel="noopener noreferrer" class="hover:text-brand-500 transition-colors">News des Vereins</a>
                </p>
              )}
              {(club.instagram || club.facebook) && (
                <p class="flex items-center gap-3 pt-1">
                  {club.instagram && (
                    <a href={club.instagram} target="_blank" rel="noopener noreferrer" aria-label={`${club.name} auf Instagram`} class="text-stone-400 hover:text-brand-500 transition-colors">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.72 3.72 0 01-1.38-.9 3.72 3.72 0 01-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.17 15.58 2.16 15.2 2.16 12s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63c-.79.3-1.46.72-2.12 1.38A5.86 5.86 0 00.63 4.14C.33 4.9.13 5.78.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91.3.79.72 1.46 1.38 2.12a5.86 5.86 0 002.13 1.38c.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.86 5.86 0 002.12-1.38 5.86 5.86 0 001.38-2.12c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.86 5.86 0 00-1.38-2.12A5.86 5.86 0 0019.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 100 12.32 6.16 6.16 0 000-12.32zM12 16a4 4 0 110-8 4 4 0 010 8zm6.4-11.85a1.44 1.44 0 100 2.88 1.44 1.44 0 000-2.88z" />
                      </svg>
                    </a>
                  )}
                  {club.facebook && (
                    <a href={club.facebook} target="_blank" rel="noopener noreferrer" aria-label={`${club.name} auf Facebook`} class="text-stone-400 hover:text-brand-500 transition-colors">
                      <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07z" />
                      </svg>
                    </a>
                  )}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

<script>
  // Suche + Sportart-Filter: filtert die Vereinskarten und die Marker auf der Karte gemeinsam.
  const search = document.getElementById('club-search') as HTMLInputElement;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('.discipline-chip')];
  const cards = [...document.querySelectorAll<HTMLElement>('.club-card')];
  const count = document.getElementById('club-count')!;
  const empty = document.getElementById('club-empty')!;

  function apply() {
    const terms = search.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
    const active = chips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.discipline!);
    const visible: string[] = [];
    for (const card of cards) {
      const text = card.dataset.search || '';
      const ds = (card.dataset.disciplines || '').split('|');
      const show = terms.every((t) => text.includes(t)) && (active.length === 0 || active.some((d) => ds.includes(d)));
      card.hidden = !show;
      if (show) visible.push(card.dataset.name!);
    }
    const filtered = terms.length > 0 || active.length > 0;
    count.textContent = filtered ? `${visible.length} von ${cards.length} Vereinen` : '';
    empty.classList.toggle('hidden', visible.length > 0);
    document.dispatchEvent(new CustomEvent('clubs:filter', { detail: { names: visible, filtered } }));
  }

  search.addEventListener('input', apply);
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      chip.setAttribute('aria-pressed', chip.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
      apply();
    }),
  );
  document.getElementById('club-reset')!.addEventListener('click', () => {
    search.value = '';
    chips.forEach((c) => c.setAttribute('aria-pressed', 'false'));
    apply();
  });
</script>
</BaseLayout>
