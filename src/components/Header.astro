---
const navItems = [
  { label: 'Verband', href: '/verband' },
  { label: 'Kantonalkader', href: '/kantonalkader' },
  { label: 'Aktuelles', href: '/aktuelles' },
  { label: 'Vereine', href: '/vereine' },
  { label: 'Veranstaltungen', href: '/veranstaltungen' },
  { label: 'Vorstand', href: '/vorstand' },
  { label: 'Kontakt', href: '/kontakt' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-white/90 backdrop-blur-md sticky top-0 z-50 border-b border-stone-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-18">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img src="/images/logo/ajv_logo.webp" alt="AJV Logo" class="h-10 lg:h-12 w-auto" />
        <span class="hidden sm:block text-xs text-stone-500 border-l border-stone-200 pl-3 leading-tight tracking-wide uppercase">
          Aargauer Judo &<br />Ju-Jitsu Verband
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-0.5">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              'px-3 py-1.5 text-sm tracking-wide transition-colors rounded-md',
              currentPath.startsWith(item.href)
                ? 'text-brand-600 bg-brand-50'
                : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100',
            ]}
          >
            {item.label}
          </a>
        ))}
        <a
          href="/mitglied-werden"
          class="ml-4 px-4 py-1.5 bg-brand-500 text-white text-sm font-semibold tracking-wide rounded-md hover:bg-brand-600 transition-colors"
        >
          Mitglied werden
        </a>
      </nav>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden p-2 text-stone-500 hover:text-stone-800 transition-colors"
        aria-label="Menu"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-stone-200/60">
    <nav class="px-4 py-4 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'block px-3 py-2.5 text-sm tracking-wide transition-colors rounded-md',
            currentPath.startsWith(item.href)
              ? 'text-brand-600 bg-brand-50'
              : 'text-stone-600 hover:text-stone-900 hover:bg-stone-100',
          ]}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/mitglied-werden"
        class="block mt-3 px-3 py-2.5 bg-brand-500 text-white text-sm font-semibold text-center tracking-wide rounded-md hover:bg-brand-600 transition-colors"
      >
        Mitglied werden
      </a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
