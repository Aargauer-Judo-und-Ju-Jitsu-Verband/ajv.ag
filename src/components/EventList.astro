---
import {
  getEvents,
  CALENDAR_ICS_URL,
  CALENDAR_WEBCAL_URL,
} from '../lib/calendar';

interface Props {
  maxEvents?: number;
  compact?: boolean;
}

const { maxEvents = 6, compact = false } = Astro.props;

const allEvents = await getEvents();
const events = allEvents.slice(0, maxEvents);

const MONTHS = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];
const WEEKDAYS = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];

function formatTime(d: Date): string {
  return d.toLocaleTimeString('de-CH', { hour: '2-digit', minute: '2-digit' });
}

function isMultiDay(ev: { start: Date; end: Date; allDay: boolean }): boolean {
  if (!ev.allDay) return false;
  const diffDays = (ev.end.getTime() - ev.start.getTime()) / (1000 * 60 * 60 * 24);
  return diffDays > 1;
}

function formatDateRange(ev: { start: Date; end: Date; allDay: boolean }): string {
  if (ev.allDay) {
    if (isMultiDay(ev)) {
      // DTEND ist bei ganztägigen Terminen exklusiv → letzter Tag = end - 1 Tag
      const lastDay = new Date(ev.end.getTime() - 24 * 60 * 60 * 1000);
      return `${ev.start.getDate()}. ${MONTHS[ev.start.getMonth()]} – ${lastDay.getDate()}. ${MONTHS[lastDay.getMonth()]}`;
    }
    return 'Ganztägig';
  }
  let timeStr = formatTime(ev.start);
  if (ev.end) timeStr += ` – ${formatTime(ev.end)}`;
  return timeStr;
}

// YYYYMMDD bzw. YYYYMMDDTHHmmSSZ für den "Zum Kalender hinzufügen"-Link
function pad(n: number): string {
  return String(n).padStart(2, '0');
}
function toGCalDate(d: Date, allDay: boolean): string {
  if (allDay) {
    return `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}`;
  }
  return d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
}
function getAddToGCalUrl(ev: {
  summary: string;
  location: string;
  description: string;
  start: Date;
  end: Date;
  allDay: boolean;
}): string {
  const text = encodeURIComponent(ev.summary || '');
  const dates = `${toGCalDate(ev.start, ev.allDay)}/${toGCalDate(ev.end, ev.allDay)}`;
  const location = encodeURIComponent(ev.location || '');
  const details = encodeURIComponent(ev.description || '');
  return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${text}&dates=${dates}&location=${location}&details=${details}`;
}
---

<div id="event-list">
  {events.length === 0 ? (
    <div class="py-8 text-center">
      <p class="text-sm text-stone-500">Keine kommenden Veranstaltungen.</p>
      <a
        href={CALENDAR_WEBCAL_URL}
        class="inline-flex items-center gap-1 mt-2 text-sm text-brand-600 hover:text-brand-700 transition-colors"
      >
        Kalender abonnieren &rarr;
      </a>
    </div>
  ) : (
    <>
      <div class="divide-y divide-stone-100">
        {events.map((ev) => {
          const day = ev.start.getDate();
          const month = MONTHS[ev.start.getMonth()];
          const weekday = WEEKDAYS[ev.start.getDay()];
          const timeInfo = formatDateRange(ev);
          const addUrl = getAddToGCalUrl(ev);

          return compact ? (
            <div class="flex items-center gap-4 py-2.5 first:pt-0 last:pb-0">
              <div class="flex-shrink-0 w-10 text-center">
                <p class="text-lg font-bold text-stone-900 leading-none">{day}</p>
                <p class="text-[10px] text-stone-500 uppercase tracking-wider">{month}</p>
              </div>
              <div class="min-w-0 flex-1 flex items-center gap-3">
                <div class="min-w-0 flex-1">
                  <div class="flex items-baseline gap-2">
                    <h3 class="font-display text-sm font-semibold text-stone-900 truncate">{ev.summary}</h3>
                    <span class="flex-shrink-0 text-xs text-stone-400">{timeInfo}</span>
                  </div>
                  {ev.location && <p class="text-xs text-stone-400 truncate">{ev.location}</p>}
                </div>
                <a
                  href={addUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  title="Zum Kalender hinzufügen"
                  class="flex-shrink-0 p-1 text-stone-300 hover:text-brand-600 hover:bg-brand-50 rounded transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                  </svg>
                </a>
              </div>
            </div>
          ) : (
            <div class="flex gap-5 py-4 first:pt-0 last:pb-0">
              <div class="flex-shrink-0 w-14 text-center">
                <p class="text-xs font-semibold text-brand-600 uppercase tracking-wider">{weekday}</p>
                <p class="text-2xl font-bold text-stone-900 leading-tight">{day}</p>
                <p class="text-xs text-stone-500 uppercase tracking-wider">{month}</p>
              </div>
              <div class="min-w-0 flex-1">
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-display font-semibold text-stone-900 leading-snug">{ev.summary}</h3>
                  <a
                    href={addUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    title="Zum Kalender hinzufügen"
                    class="flex-shrink-0 mt-0.5 p-1.5 text-stone-300 hover:text-brand-600 hover:bg-brand-50 rounded transition-colors"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                    </svg>
                  </a>
                </div>
                <p class="mt-1 text-sm text-stone-500">{timeInfo}</p>
                {ev.location && <p class="mt-0.5 text-sm text-stone-400 truncate">{ev.location}</p>}
                {ev.url && (
                  <a
                    href={ev.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-1.5 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors"
                  >
                    <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
                    </svg>
                    Mehr Infos
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>

      {!compact && (
        <div class="mt-6 pt-6 border-t border-stone-200 flex flex-wrap items-center gap-3">
          <span class="text-xs text-stone-400 uppercase tracking-wider font-semibold">Kalender abonnieren</span>
          <a
            href={CALENDAR_WEBCAL_URL}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-brand-600 bg-brand-50 rounded-md hover:bg-brand-100 transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            iCal / Outlook / Apple
          </a>
          <a
            href={CALENDAR_ICS_URL}
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-brand-600 bg-brand-50 rounded-md hover:bg-brand-100 transition-colors"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3M4 6h16M4 6V4a1 1 0 011-1h14a1 1 0 011 1v2M4 6v14a1 1 0 001 1h14a1 1 0 001-1V6" />
            </svg>
            .ics herunterladen
          </a>
        </div>
      )}
    </>
  )}
</div>
