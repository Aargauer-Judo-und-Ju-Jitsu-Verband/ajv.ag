---
// Renders upcoming AJV events from the /api/events Netlify Function (Webling REST).
// - compact: condensed rows for the homepage (no filter chips)
// - full:    cards with calendar tag filter chips, image, description, signup
interface Props {
  maxEvents?: number;
  compact?: boolean;
}

const { maxEvents = 6, compact = false } = Astro.props;
---

<div
  id="event-list"
  data-max-events={maxEvents}
  data-compact={compact ? 'true' : 'false'}
>
  <!-- Loading -->
  <div id="event-loading" class="flex items-center justify-center py-12">
    <div class="flex items-center gap-3 text-stone-400">
      <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span class="text-sm">Veranstaltungen werden geladen…</span>
    </div>
  </div>

  <!-- Error -->
  <div id="event-error" class="hidden py-8 text-center">
    <p class="text-sm text-stone-500">Kalender konnte nicht geladen werden.</p>
  </div>

  <!-- Filter chips (full mode only) -->
  <div id="event-filters" class="hidden mb-6 flex flex-wrap items-center gap-2"></div>

  <!-- Events -->
  <div id="event-items" class="hidden"></div>

  <!-- Empty -->
  <div id="event-empty" class="hidden py-8 text-center">
    <p class="text-sm text-stone-500">Keine kommenden Veranstaltungen.</p>
  </div>
</div>

<script>
  interface Signup { max: number | null; count: number; until: string | null }
  interface AjvEvent {
    id: number | null;
    title: string;
    descriptionHtml: string;
    place: string;
    begin: string | null;
    end: string | null;
    beginRaw: string | null;
    endRaw: string | null;
    isAllDay: boolean;
    status: string;
    calendarId: number | null;
    calendar: string;
    calendarColor: string | null;
    signup: Signup | null;
  }

  const container = document.getElementById('event-list')!;
  const maxEvents = parseInt(container.dataset.maxEvents || '6', 10);
  const isCompact = container.dataset.compact === 'true';

  const loadingEl = document.getElementById('event-loading')!;
  const errorEl = document.getElementById('event-error')!;
  const filtersEl = document.getElementById('event-filters')!;
  const itemsEl = document.getElementById('event-items')!;
  const emptyEl = document.getElementById('event-empty')!;

  const MONTHS = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];
  const WEEKDAYS = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];

  // Webling events carry no image field. Resolve a picture per event:
  //   1. explicit override by title  2. per-calendar default  3. none (colour accent)
  const EVENT_IMAGE_OVERRIDES: Record<string, string> = {
    'Aargauer Ju-Jitsu-Day': '/images/events/ju-jitsu-day-1.webp',
  };
  const CALENDAR_DEFAULT_IMAGE: Record<string, string> = {
    // e.g. 'Kantonalkader': '/images/events/kader.webp'
  };
  function imageFor(ev: AjvEvent): string {
    return EVENT_IMAGE_OVERRIDES[ev.title] || CALENDAR_DEFAULT_IMAGE[ev.calendar] || '';
  }

  const FILTER_KEY = 'ajv-event-filter';

  let allEvents: AjvEvent[] = [];
  let calendarsInData: string[] = [];
  let activeCalendars = new Set<string>();

  function ymd(raw: string | null): [number, number, number] {
    const [d] = (raw || '').split(' ');
    const [y, m, dd] = d.split('-').map(Number);
    return [y, m, dd];
  }

  function isMultiDayAllDay(ev: AjvEvent): boolean {
    if (!ev.isAllDay || !ev.beginRaw || !ev.endRaw) return false;
    const [sy, sm, sd] = ymd(ev.beginRaw);
    const [ey, em, ed] = ymd(ev.endRaw);
    const diff = (Date.UTC(ey, em - 1, ed) - Date.UTC(sy, sm - 1, sd)) / 86400000;
    return diff > 1; // end is exclusive (midnight of the following day)
  }

  function startDate(ev: AjvEvent): Date {
    const [y, m, d] = ymd(ev.beginRaw);
    return new Date(y, m - 1, d);
  }

  function formatTimeInfo(ev: AjvEvent): string {
    if (ev.isAllDay) {
      if (isMultiDayAllDay(ev)) {
        const [ey, em, ed] = ymd(ev.endRaw); // exclusive → last day is end - 1
        const last = new Date(ey, em - 1, ed - 1);
        return `${startDate(ev).getDate()}. ${MONTHS[startDate(ev).getMonth()]} – ${last.getDate()}. ${MONTHS[last.getMonth()]}`;
      }
      return 'Ganztägig';
    }
    const fmt = (iso: string) =>
      new Date(iso).toLocaleTimeString('de-CH', { hour: '2-digit', minute: '2-digit' });
    let s = ev.begin ? fmt(ev.begin) : '';
    if (ev.end) s += ` – ${fmt(ev.end)}`;
    return s;
  }

  function toGCalStamp(ev: AjvEvent, which: 'begin' | 'end'): string {
    if (ev.isAllDay) {
      const raw = which === 'begin' ? ev.beginRaw : ev.endRaw;
      return (raw || '').split(' ')[0].replace(/-/g, '');
    }
    const iso = which === 'begin' ? ev.begin : ev.end;
    return new Date(iso!).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
  }

  function addToGCalUrl(ev: AjvEvent): string {
    const text = encodeURIComponent(ev.title);
    const dates = `${toGCalStamp(ev, 'begin')}/${toGCalStamp(ev, 'end')}`;
    const location = encodeURIComponent(ev.place || '');
    // Strip HTML from description for the calendar details field.
    const tmp = document.createElement('div');
    tmp.innerHTML = ev.descriptionHtml || '';
    const details = encodeURIComponent(tmp.textContent || '');
    return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${text}&dates=${dates}&location=${location}&details=${details}`;
  }

  function tagBadge(ev: AjvEvent): string {
    if (!ev.calendar) return '';
    const color = ev.calendarColor || '#2A57C5';
    return `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold" style="color:${color};background:${color}1a">
      <span class="w-1.5 h-1.5 rounded-full" style="background:${color}"></span>${ev.calendar}</span>`;
  }

  function canceledBadge(ev: AjvEvent): string {
    return ev.status === 'canceled'
      ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold text-red-600 bg-red-50">Abgesagt</span>`
      : '';
  }

  function signupInfo(ev: AjvEvent): string {
    if (!ev.signup) return '';
    const { max, count } = ev.signup;
    const label = max ? `${count}/${max} Plätze` : `${count} Anmeldungen`;
    return `<span class="inline-flex items-center gap-1.5 text-xs text-stone-500">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4z"/></svg>
      ${label}</span>`;
  }

  function renderCompact(ev: AjvEvent): string {
    const d = startDate(ev);
    const canceled = ev.status === 'canceled';
    return `
      <div class="flex items-center gap-4 py-2.5 first:pt-0 last:pb-0">
        <div class="flex-shrink-0 w-10 text-center">
          <p class="text-lg font-bold text-stone-900 leading-none ${canceled ? 'line-through text-stone-400' : ''}">${d.getDate()}</p>
          <p class="text-[10px] text-stone-500 uppercase tracking-wider">${MONTHS[d.getMonth()]}</p>
        </div>
        <div class="min-w-0 flex-1 flex items-center gap-3">
          <div class="min-w-0 flex-1">
            <div class="flex items-baseline gap-2">
              <h3 class="font-display text-sm font-semibold text-stone-900 truncate ${canceled ? 'line-through text-stone-400' : ''}">${ev.title}</h3>
              <span class="flex-shrink-0 text-xs text-stone-400">${formatTimeInfo(ev)}</span>
            </div>
            ${ev.place ? `<p class="text-xs text-stone-400 truncate">${ev.place}</p>` : ''}
          </div>
          <a href="${addToGCalUrl(ev)}" target="_blank" rel="noopener noreferrer" title="Zum Kalender hinzufügen"
             class="flex-shrink-0 p-1 text-stone-300 hover:text-brand-600 hover:bg-brand-50 rounded transition-colors">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          </a>
        </div>
      </div>`;
  }

  function renderCard(ev: AjvEvent): string {
    const d = startDate(ev);
    const canceled = ev.status === 'canceled';
    const color = ev.calendarColor || '#2A57C5';
    const img = imageFor(ev);
    const media = img
      ? `<img src="${img}" alt="" loading="lazy" class="w-full sm:w-40 h-32 sm:h-auto object-cover rounded-lg" />`
      : `<div class="hidden sm:flex w-40 rounded-lg items-center justify-center" style="background:${color}14">
           <div class="text-center">
             <p class="text-3xl font-bold" style="color:${color}">${d.getDate()}</p>
             <p class="text-xs uppercase tracking-wider" style="color:${color}">${MONTHS[d.getMonth()]}</p>
           </div>
         </div>`;

    return `
      <article class="flex flex-col sm:flex-row gap-5 py-6 first:pt-0 last:pb-0">
        <div class="flex-shrink-0">${media}</div>
        <div class="min-w-0 flex-1">
          <div class="flex flex-wrap items-center gap-2 mb-1.5">
            <span class="text-xs font-semibold text-brand-600 uppercase tracking-wider">${WEEKDAYS[d.getDay()]}, ${d.getDate()}. ${MONTHS[d.getMonth()]}</span>
            ${tagBadge(ev)}
            ${canceledBadge(ev)}
          </div>
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-display text-lg font-semibold text-stone-900 leading-snug ${canceled ? 'line-through text-stone-400' : ''}">${ev.title}</h3>
            <a href="${addToGCalUrl(ev)}" target="_blank" rel="noopener noreferrer" title="Zum Kalender hinzufügen"
               class="flex-shrink-0 mt-0.5 p-1.5 text-stone-300 hover:text-brand-600 hover:bg-brand-50 rounded transition-colors">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            </a>
          </div>
          <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-stone-500">
            <span>${formatTimeInfo(ev)}</span>
            ${ev.place ? `<span class="inline-flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>${ev.place}</span>` : ''}
            ${signupInfo(ev)}
          </div>
          ${ev.descriptionHtml ? `<div class="mt-2 text-sm text-stone-600 leading-relaxed prose-links">${ev.descriptionHtml}</div>` : ''}
        </div>
      </article>`;
  }

  function visibleEvents(): AjvEvent[] {
    let list = allEvents;
    if (!isCompact && activeCalendars.size > 0) {
      list = list.filter((e) => !e.calendar || activeCalendars.has(e.calendar));
    }
    return list.slice(0, maxEvents);
  }

  function renderList() {
    const list = visibleEvents();
    if (list.length === 0) {
      itemsEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
      return;
    }
    emptyEl.classList.add('hidden');
    if (isCompact) {
      itemsEl.className = 'divide-y divide-stone-100';
      itemsEl.innerHTML = list.map(renderCompact).join('');
    } else {
      itemsEl.className = 'divide-y divide-stone-200';
      itemsEl.innerHTML = list.map(renderCard).join('');
    }
    itemsEl.classList.remove('hidden');
  }

  function renderFilters() {
    if (isCompact || calendarsInData.length < 2) return;
    filtersEl.innerHTML =
      `<span class="text-xs text-stone-400 uppercase tracking-wider font-semibold mr-1">Filter</span>` +
      calendarsInData
        .map((cal) => {
          const on = activeCalendars.has(cal);
          return `<button type="button" data-cal="${cal}"
            class="px-3 py-1.5 rounded-full text-xs font-semibold border transition-colors ${
              on
                ? 'bg-brand-600 text-white border-brand-600'
                : 'bg-white text-stone-500 border-stone-300 hover:border-brand-400'
            }">${cal}</button>`;
        })
        .join('');
    filtersEl.classList.remove('hidden');

    filtersEl.querySelectorAll<HTMLButtonElement>('button[data-cal]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const cal = btn.dataset.cal!;
        if (activeCalendars.has(cal)) {
          if (activeCalendars.size > 1) activeCalendars.delete(cal); // keep at least one
        } else {
          activeCalendars.add(cal);
        }
        try {
          sessionStorage.setItem(FILTER_KEY, JSON.stringify([...activeCalendars]));
        } catch {}
        renderFilters();
        renderList();
      });
    });
  }

  async function load() {
    try {
      const res = await fetch('/api/events');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      allEvents = (data.events || []) as AjvEvent[];

      loadingEl.classList.add('hidden');

      if (allEvents.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      // Distinct calendars actually present, in the API's calendar order.
      const order: string[] = data.calendars || [];
      const present = new Set(allEvents.map((e) => e.calendar).filter(Boolean));
      calendarsInData = order.filter((c) => present.has(c));

      // Restore saved filter, else all on.
      let saved: string[] | null = null;
      try {
        saved = JSON.parse(sessionStorage.getItem(FILTER_KEY) || 'null');
      } catch {}
      activeCalendars = new Set(
        saved ? saved.filter((c) => calendarsInData.includes(c)) : calendarsInData
      );
      if (activeCalendars.size === 0) activeCalendars = new Set(calendarsInData);

      renderFilters();
      renderList();
    } catch (e) {
      console.error('Failed to load events:', e);
      loadingEl.classList.add('hidden');
      errorEl.classList.remove('hidden');
    }
  }

  load();
</script>

<style>
  /* Ensure links inside event descriptions are visibly clickable. */
  .prose-links :global(a) {
    color: var(--color-brand-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-links :global(a:hover) {
    color: var(--color-brand-700);
  }
</style>
