---
import { CALENDAR_ICS, icsWebcalUrl, icsGoogleUrl } from '../lib/eventFormat';

// Renders AJV events from the /api/events Netlify Function (Webling REST).
// - compact: condensed rows (homepage), no filter chips
// - full:    cards with calendar tag filter chips + past toggle
// - calendars: optional allowlist — only show events from these calendars
//   (used on the homepage to split "AJV" from "Kantonalkader & SMM")
//
// The "Kalender abonnieren" block (full view only, above the list) is rendered
// server-side from the static CALENDAR_ICS map, so people can still subscribe
// when /api/events is down or JavaScript never runs. It is a <details> rather
// than a modal: the site has no dialog pattern anywhere, and a disclosure needs
// no focus trap, no scroll lock and no JavaScript at all.
//
// The component supports MULTIPLE instances per page: the hoisted <script> runs
// once, then initialises every .event-list root it finds, scoped to that root.
interface Props {
  maxEvents?: number;
  compact?: boolean;
  calendars?: string[]; // allowlist: only show these calendars
  exclude?: string[];   // blocklist: show all calendars except these
}

const { maxEvents = 6, compact = false, calendars = [], exclude = [] } = Astro.props;

// Calendars this instance may show — same allow-/blocklist the event filtering
// uses, applied to the calendars we have a feed for. Map order = chip order.
const subscribable = Object.keys(CALENDAR_ICS).filter(
  (c) =>
    (!calendars.length || calendars.includes(c)) &&
    (!exclude.length || !exclude.includes(c))
);
---

<div
  class="event-list"
  data-max-events={maxEvents}
  data-compact={compact ? 'true' : 'false'}
  data-calendars={calendars.join(',')}
  data-exclude={exclude.join(',')}
>
  <!-- Loading -->
  <div data-el="loading" class="flex items-center justify-center py-12">
    <div class="flex items-center gap-3 text-stone-400">
      <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span class="text-sm">Veranstaltungen werden geladen…</span>
    </div>
  </div>

  <!-- Error -->
  <div data-el="error" class="hidden py-8 text-center">
    <p class="text-sm text-stone-500">Kalender konnte nicht geladen werden.</p>
  </div>

  <!-- Filters + past toggle (full mode only) -->
  <div data-el="controls" class="hidden mb-6 flex flex-wrap items-center justify-between gap-3">
    <div data-el="filters" class="flex flex-wrap items-center gap-2"></div>
    <div data-el="pasttoggle"></div>
  </div>

  <!-- Subscribe: full view only, above the list so it is not missed, and
       server-rendered so it survives an /api/events outage or no JavaScript. -->
  {!compact && subscribable.length > 0 && (
    <details class="group mb-6">
      <summary class="inline-flex w-fit cursor-pointer items-center gap-1.5 rounded-full bg-brand-50 px-3 py-1.5 text-xs font-semibold text-brand-600 hover:bg-brand-100 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        Kalender abonnieren
        <!-- flex on <summary> drops the native marker, so bring our own. -->
        <svg class="w-3 h-3 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </summary>
      <div class="mt-3 rounded-lg border border-stone-200 bg-stone-50 p-4 space-y-4">
        <p class="text-sm text-stone-500 leading-relaxed">
          Ein abonnierter Kalender aktualisiert sich von selbst — neue und geänderte
          Termine erscheinen automatisch in deinem Kalender.
        </p>
        <div>
          <p class="mb-2 text-xs font-semibold text-stone-400">Apple Kalender, Outlook</p>
          <div class="flex flex-wrap gap-2">
            {subscribable.map((cal) => (
              <a
                href={icsWebcalUrl(cal)}
                title={`${cal}-Kalender abonnieren (iCal)`}
                class="px-3 py-1.5 rounded-full text-xs font-semibold text-brand-600 bg-brand-50 hover:bg-brand-100 transition-colors"
              >
                {cal}
              </a>
            ))}
          </div>
        </div>
        <div>
          <p class="mb-2 text-xs font-semibold text-stone-400">Google Kalender</p>
          <div class="flex flex-wrap gap-2">
            {subscribable.map((cal) => (
              <a
                href={icsGoogleUrl(cal)}
                target="_blank"
                rel="noopener noreferrer"
                title={`${cal}-Kalender im Google Kalender hinzufügen`}
                class="px-3 py-1.5 rounded-full text-xs font-semibold text-brand-600 bg-brand-50 hover:bg-brand-100 transition-colors"
              >
                {cal}
              </a>
            ))}
          </div>
        </div>
      </div>
    </details>
  )}

  <!-- Events -->
  <div data-el="items" class="hidden"></div>

  <!-- Empty -->
  <div data-el="empty" class="hidden py-8 text-center">
    <p class="text-sm text-stone-500">Keine kommenden Veranstaltungen.</p>
  </div>

</div>

<script>
  import {
    type AjvEvent,
    MONTHS,
    WEEKDAYS,
    GROUP_ORDER,
    calendarGroup,
    imageFor,
    startDate,
    formatTimeInfo,
    addToGCalUrl,
  } from '../lib/eventFormat';

  const FILTER_KEY = 'ajv-event-filter';
  const PAST_KEY = 'ajv-event-showpast';
  const DEFAULT_CALENDAR = 'AJV'; // full view: only AJV selected by default
  // Chip order: AJV first, then Kantonalkader, then the SMM leagues.
  const groupRank = (c: string) => {
    const i = GROUP_ORDER.indexOf(calendarGroup(c));
    return i === -1 ? GROUP_ORDER.length : i;
  };

  // Shared, memoised fetches so multiple instances on one page (e.g. the two
  // homepage cards) don't each hit /api/events.
  let upcomingPromise: Promise<any> | null = null;
  let pastPromise: Promise<any> | null = null;
  function fetchUpcoming() {
    if (!upcomingPromise) {
      upcomingPromise = fetch('/api/events').then((r) => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.json();
      });
    }
    return upcomingPromise;
  }
  function fetchPast() {
    if (!pastPromise) {
      pastPromise = fetch('/api/events?past=1').then((r) => {
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        return r.json();
      });
    }
    return pastPromise;
  }

  function initEventList(root: HTMLElement) {
    const maxEvents = parseInt(root.dataset.maxEvents || '6', 10);
    const isCompact = root.dataset.compact === 'true';
    // Allowlist / blocklist of calendars (empty = no restriction).
    const restrictCalendars = (root.dataset.calendars || '')
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);
    const excludeCalendars = (root.dataset.exclude || '')
      .split(',')
      .map((s) => s.trim())
      .filter(Boolean);

    const q = (name: string) => root.querySelector<HTMLElement>(`[data-el="${name}"]`)!;
    const loadingEl = q('loading');
    const errorEl = q('error');
    const controlsEl = q('controls');
    const filtersEl = q('filters');
    const pastToggleEl = q('pasttoggle');
    const itemsEl = q('items');
    const emptyEl = q('empty');

    let allEvents: AjvEvent[] = [];
    let calendarOrder: string[] = [];
    let calendarsInData: string[] = []; // calendars present → one filter chip each
    let activeCalendars = new Set<string>();

    let showPast = false;
    let pastEvents: AjvEvent[] | null = null;
    let pastLoading = false;

    // Present calendars (respecting allow-/blocklist), ordered AJV → Kantonalkader
    // → SMM leagues (group rank first, then the API's own order within a group).
    function recomputeCalendars() {
      const present = new Set<string>();
      for (const e of allEvents) if (e.calendar) present.add(e.calendar);
      if (pastEvents) for (const e of pastEvents) if (e.calendar) present.add(e.calendar);
      calendarsInData = calendarOrder
        .filter(
          (c) =>
            present.has(c) &&
            (!restrictCalendars.length || restrictCalendars.includes(c)) &&
            (!excludeCalendars.length || !excludeCalendars.includes(c))
        )
        .map((c, i) => ({ c, i }))
        .sort((a, b) => groupRank(a.c) - groupRank(b.c) || a.i - b.i)
        .map((x) => x.c);
    }

    // Restrict to the allow-/blocklisted calendars (applies to both modes).
    function baseFilter(list: AjvEvent[]): AjvEvent[] {
      let l = list;
      if (restrictCalendars.length) l = l.filter((e) => e.calendar && restrictCalendars.includes(e.calendar));
      if (excludeCalendars.length) l = l.filter((e) => !excludeCalendars.includes(e.calendar));
      return l;
    }

    // Full-view chip filter by calendar (no-op in compact mode).
    function applyFilter(list: AjvEvent[]): AjvEvent[] {
      if (!isCompact && activeCalendars.size > 0) {
        return list.filter((e) => !e.calendar || activeCalendars.has(e.calendar));
      }
      return list;
    }

    function tagBadge(ev: AjvEvent): string {
      if (!ev.calendar) return '';
      const color = ev.calendarColor || '#2A57C5';
      return `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold" style="color:${color};background:${color}1a">
        <span class="w-1.5 h-1.5 rounded-full" style="background:${color}"></span>${ev.calendar}</span>`;
    }

    function canceledBadge(ev: AjvEvent): string {
      return ev.status === 'canceled'
        ? `<span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-semibold text-red-600 bg-red-50">Abgesagt</span>`
        : '';
    }

    function signupInfo(ev: AjvEvent): string {
      if (!ev.signup) return '';
      const { max, count } = ev.signup;
      const label = max ? `${count}/${max} Plätze` : `${count} Anmeldungen`;
      return `<span class="inline-flex items-center gap-1.5 text-xs text-stone-500">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 10-4-4 4 4 0 004 4z"/></svg>
        ${label}</span>`;
    }

    function renderCompact(ev: AjvEvent): string {
      const d = startDate(ev);
      const canceled = ev.status === 'canceled';
      return `
        <div ${ev.id != null ? `data-id="${ev.id}" role="link" tabindex="0"` : ''} class="flex items-center gap-4 py-2.5 first:pt-0 last:pb-0 ${ev.id != null ? 'cursor-pointer group' : ''}">
          <div class="flex-shrink-0 w-10 text-center">
            <p class="text-lg font-bold text-stone-900 leading-none ${canceled ? 'line-through text-stone-400' : ''}">${d.getDate()}</p>
            <p class="text-[10px] text-stone-500 uppercase tracking-wider">${MONTHS[d.getMonth()]}</p>
          </div>
          <div class="min-w-0 flex-1 flex items-center gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline gap-2 min-w-0">
                <h3 class="min-w-0 font-display text-sm font-semibold text-stone-900 truncate group-hover:text-brand-600 transition-colors ${canceled ? 'line-through text-stone-400' : ''}">${ev.title}</h3>
                <span class="flex-shrink-0 text-xs text-stone-400">${formatTimeInfo(ev)}</span>
              </div>
              ${ev.place ? `<p class="text-xs text-stone-400 truncate">${ev.place}</p>` : ''}
            </div>
            <a href="${addToGCalUrl(ev)}" target="_blank" rel="noopener noreferrer" title="Zum Kalender hinzufügen"
               class="flex-shrink-0 p-1 text-stone-300 hover:text-brand-600 hover:bg-brand-50 rounded transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            </a>
          </div>
        </div>`;
    }

    function renderCard(ev: AjvEvent): string {
      const d = startDate(ev);
      const canceled = ev.status === 'canceled';
      const color = ev.calendarColor || '#2A57C5';
      const img = imageFor(ev);
      const media = img
        ? `<img src="${img}" alt="" loading="lazy" class="w-full sm:w-40 h-32 sm:h-auto object-cover rounded-lg" />`
        : `<div class="hidden sm:flex w-40 rounded-lg items-center justify-center" style="background:${color}14">
             <div class="text-center">
               <p class="text-3xl font-bold" style="color:${color}">${d.getDate()}</p>
               <p class="text-xs uppercase tracking-wider" style="color:${color}">${MONTHS[d.getMonth()]}</p>
             </div>
           </div>`;

      return `
        <article ${ev.id != null ? `data-id="${ev.id}" role="link" tabindex="0"` : ''} class="flex flex-col sm:flex-row gap-5 py-6 first:pt-0 last:pb-0 ${ev.id != null ? 'cursor-pointer group' : ''}">
          <div class="flex-shrink-0">${media}</div>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2 mb-1.5">
              <span class="text-xs font-semibold text-brand-600 uppercase tracking-wider">${WEEKDAYS[d.getDay()]}, ${d.getDate()}. ${MONTHS[d.getMonth()]}</span>
              ${tagBadge(ev)}
              ${canceledBadge(ev)}
            </div>
            <div class="flex items-start justify-between gap-3">
              <h3 class="min-w-0 break-words font-display text-lg font-semibold text-stone-900 leading-snug group-hover:text-brand-600 transition-colors ${canceled ? 'line-through text-stone-400' : ''}">${ev.title}</h3>
              <a href="${addToGCalUrl(ev)}" target="_blank" rel="noopener noreferrer" title="Zum Kalender hinzufügen"
                 class="flex-shrink-0 mt-0.5 p-1.5 text-stone-300 hover:text-brand-600 hover:bg-brand-50 rounded transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
              </a>
            </div>
            <div class="mt-1 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-stone-500">
              <span>${formatTimeInfo(ev)}</span>
              ${ev.place ? `<span class="inline-flex items-center gap-1"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>${ev.place}</span>` : ''}
              ${signupInfo(ev)}
            </div>
            ${ev.descriptionHtml ? `<div class="mt-2 text-sm text-stone-600 leading-relaxed prose-links break-words">${ev.descriptionHtml}</div>` : ''}
          </div>
        </article>`;
    }

    function renderList() {
      const render = isCompact ? renderCompact : renderCard;
      const divide = isCompact ? 'divide-y divide-stone-100' : 'divide-y divide-stone-200';

      const upcoming = applyFilter(baseFilter(allEvents)).slice(0, maxEvents);
      // Compact (homepage) never shows past events, regardless of stored state.
      const past =
        !isCompact && showPast && pastEvents ? applyFilter(baseFilter(pastEvents)).slice(0, maxEvents) : [];

      if (upcoming.length === 0 && past.length === 0) {
        itemsEl.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        return;
      }
      emptyEl.classList.add('hidden');

      let html = `<div class="${divide}">${upcoming.map(render).join('')}</div>`;
      if (past.length > 0) {
        html += `
          <div class="mt-8 pt-6 border-t border-stone-200">
            <h3 class="text-xs font-semibold text-stone-400 uppercase tracking-wider mb-2">Vergangene Termine</h3>
            <div class="${divide} opacity-70">${past.map(render).join('')}</div>
          </div>`;
      }
      itemsEl.className = '';
      itemsEl.innerHTML = html;
      itemsEl.classList.remove('hidden');
      attachItemHandlers();
    }

    // Each row/card navigates to its detail page; inner links keep their behaviour.
    function attachItemHandlers() {
      itemsEl.querySelectorAll<HTMLElement>('[data-id]').forEach((el) => {
        const id = el.dataset.id!;
        const go = () => {
          window.location.href = `/veranstaltung?id=${id}`;
        };
        el.addEventListener('click', go);
        el.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            go();
          }
        });
      });
      itemsEl.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', (e) => e.stopPropagation());
      });
    }

    function renderControls() {
      if (isCompact) return;
      renderFilters();
      renderPastToggle();
      controlsEl.classList.remove('hidden');
    }

    function renderFilters() {
      if (calendarsInData.length < 2) {
        filtersEl.innerHTML = '';
        return;
      }
      filtersEl.innerHTML =
        `<span class="text-xs text-stone-400 uppercase tracking-wider font-semibold mr-1">Filter</span>` +
        calendarsInData
          .map((cal) => {
            const on = activeCalendars.has(cal);
            return `<button type="button" data-cal="${cal}"
              class="px-3 py-1.5 rounded-full text-xs font-semibold border transition-colors ${
                on
                  ? 'bg-brand-600 text-white border-brand-600'
                  : 'bg-white text-stone-500 border-stone-300 hover:border-brand-400'
              }">${cal}</button>`;
          })
          .join('');

      filtersEl.querySelectorAll<HTMLButtonElement>('button[data-cal]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const cal = btn.dataset.cal!;
          if (activeCalendars.has(cal)) {
            if (activeCalendars.size > 1) activeCalendars.delete(cal); // keep at least one
          } else {
            activeCalendars.add(cal);
          }
          persistSelection();
          renderFilters();
          renderList();
        });
      });
    }

    function renderPastToggle() {
      const label = pastLoading ? 'Vergangene Termine werden geladen…' : 'Vergangene Termine anzeigen';
      pastToggleEl.innerHTML = `
        <button type="button" role="switch" aria-checked="${showPast}"
          class="inline-flex items-center gap-2 text-xs font-semibold text-stone-500 hover:text-stone-700 transition-colors">
          <span class="relative inline-flex h-5 w-9 items-center rounded-full transition-colors ${
            showPast ? 'bg-brand-600' : 'bg-stone-300'
          }">
            <span class="inline-block h-4 w-4 transform rounded-full bg-white shadow transition-transform ${
              showPast ? 'translate-x-4' : 'translate-x-0.5'
            }"></span>
          </span>
          ${label}
        </button>`;
      pastToggleEl.querySelector('button')!.addEventListener('click', togglePast);
    }

    // Persist the calendar selection to sessionStorage and reflect it in the URL
    // (?kalender=…) so filtered views can be shared by link.
    function persistSelection() {
      try {
        sessionStorage.setItem(FILTER_KEY, JSON.stringify([...activeCalendars]));
      } catch {}
      const value = calendarsInData.filter((c) => activeCalendars.has(c)).join(',');
      history.replaceState(null, '', value ? `${location.pathname}?kalender=${encodeURIComponent(value)}` : location.pathname);
    }

    // Initial selection: URL (?kalender=) > sessionStorage > default (AJV only).
    function initialSelection(): Set<string> {
      const urlParam = new URLSearchParams(location.search).get('kalender');
      if (urlParam) {
        const valid = urlParam.split(',').map((s) => s.trim()).filter((c) => calendarsInData.includes(c));
        if (valid.length) return new Set(valid);
      }
      try {
        const saved = JSON.parse(sessionStorage.getItem(FILTER_KEY) || 'null');
        if (Array.isArray(saved)) {
          const valid = saved.filter((c: string) => calendarsInData.includes(c));
          if (valid.length) return new Set(valid);
        }
      } catch {}
      if (calendarsInData.includes(DEFAULT_CALENDAR)) return new Set([DEFAULT_CALENDAR]);
      return new Set(calendarsInData);
    }

    async function loadPast() {
      try {
        const data = await fetchPast();
        pastEvents = (data.events || []) as AjvEvent[];
      } catch (e) {
        console.error('Failed to load past events:', e);
        pastEvents = [];
      }
    }

    async function togglePast() {
      showPast = !showPast;
      try {
        sessionStorage.setItem(PAST_KEY, showPast ? '1' : '0');
      } catch {}
      if (showPast && pastEvents === null && !pastLoading) {
        pastLoading = true;
        renderPastToggle();
        await loadPast();
        pastLoading = false;
        recomputeCalendars();
        renderControls();
      } else {
        renderPastToggle();
      }
      renderList();
    }

    async function load() {
      try {
        const data = await fetchUpcoming();
        loadingEl.classList.add('hidden');
        // A configured/upstream problem returns { events: [], error }. Show the
        // error state so it doesn't look like "no events".
        if (data.error) {
          console.error('Events API error:', data.error);
          errorEl.classList.remove('hidden');
          return;
        }
        allEvents = (data.events || []) as AjvEvent[];

        calendarOrder = (data.calendars || []) as string[];
        recomputeCalendars();

        if (!isCompact) {
          activeCalendars = initialSelection();
          persistSelection(); // reflect the effective selection in the URL
          try {
            showPast = sessionStorage.getItem(PAST_KEY) === '1';
          } catch {}
        }

        renderControls();
        renderList();

        if (!isCompact && showPast && pastEvents === null && !pastLoading) {
          pastLoading = true;
          renderPastToggle();
          await loadPast();
          pastLoading = false;
          recomputeCalendars();
          renderControls();
          renderList();
        }
      } catch (e) {
        console.error('Failed to load events:', e);
        loadingEl.classList.add('hidden');
        errorEl.classList.remove('hidden');
      }
    }

    load();
  }

  document.querySelectorAll<HTMLElement>('.event-list').forEach(initEventList);
</script>

<style>
  /* Ensure links inside event descriptions are visibly clickable. */
  .prose-links :global(a) {
    color: var(--color-brand-600);
    text-decoration: underline;
    text-underline-offset: 2px;
    overflow-wrap: anywhere; /* break long bare URLs instead of overflowing */
  }
  .prose-links :global(a:hover) {
    color: var(--color-brand-700);
  }
</style>
