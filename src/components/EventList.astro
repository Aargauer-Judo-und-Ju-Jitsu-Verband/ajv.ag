---
interface Props {
  maxEvents?: number;
  compact?: boolean;
  showFilters?: boolean;
}

const { maxEvents = 6, compact = false, showFilters = false } = Astro.props;

const CALENDAR_ID = import.meta.env.PUBLIC_GOOGLE_CALENDAR_ID || '';
const ICAL_URL = `https://calendar.google.com/calendar/ical/${CALENDAR_ID}/public/basic.ics`;
const GCAL_SUB_URL = `https://calendar.google.com/calendar/render?cid=${CALENDAR_ID}`;
---

<div
  id="event-list"
  data-max-events={maxEvents}
  data-compact={compact ? 'true' : 'false'}
  data-show-filters={showFilters ? 'true' : 'false'}
>
  {showFilters && (
    <div id="event-filters" class="hidden mb-6 pb-6 border-b border-stone-200">
      <p class="text-xs text-stone-400 uppercase tracking-wider font-semibold mb-3">Filter</p>
      <div id="event-filter-chips" class="flex flex-wrap gap-2"></div>
    </div>
  )}

  <!-- Loading state -->
  <div id="event-loading" class="flex items-center justify-center py-12">
    <div class="flex items-center gap-3 text-stone-400">
      <svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
      </svg>
      <span class="text-sm">Veranstaltungen werden geladen…</span>
    </div>
  </div>

  <!-- Error state -->
  <div id="event-error" class="hidden py-8 text-center">
    <p class="text-sm text-stone-500">Kalender konnte nicht geladen werden.</p>
    <a
      href={`https://calendar.google.com/calendar/embed?src=${CALENDAR_ID}`}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 mt-2 text-sm text-brand-600 hover:text-brand-700 transition-colors"
    >
      Kalender direkt öffnen &rarr;
    </a>
  </div>

  <!-- Events container -->
  <div id="event-items" class="hidden divide-y divide-stone-100"></div>

  <!-- Empty state -->
  <div id="event-empty" class="hidden py-8 text-center">
    <p class="text-sm text-stone-500">Keine kommenden Veranstaltungen.</p>
  </div>

  <!-- Subscribe bar -->
  <div id="event-subscribe" class="hidden mt-6 pt-6 border-t border-stone-200 flex flex-wrap items-center gap-3">
    <span class="text-xs text-stone-400 uppercase tracking-wider font-semibold">AJV-Kalender abonnieren</span>
    <a
      href={GCAL_SUB_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-brand-600 bg-brand-50 rounded-md hover:bg-brand-100 transition-colors"
    >
      <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" /><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" /><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" /><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
      </svg>
      Google
    </a>
    <a
      href={ICAL_URL}
      class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-brand-600 bg-brand-50 rounded-md hover:bg-brand-100 transition-colors"
    >
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
      </svg>
      iCal / Outlook
    </a>
  </div>
</div>

<script>
  const container = document.getElementById('event-list')!;
  const maxEvents = parseInt(container.dataset.maxEvents || '6', 10);
  const isCompact = container.dataset.compact === 'true';
  const showFilters = container.dataset.showFilters === 'true';

  const filtersEl = document.getElementById('event-filters');
  const chipsEl = document.getElementById('event-filter-chips');
  const loadingEl = document.getElementById('event-loading')!;
  const errorEl = document.getElementById('event-error')!;
  const itemsEl = document.getElementById('event-items')!;
  const emptyEl = document.getElementById('event-empty')!;
  const subscribeEl = document.getElementById('event-subscribe')!;

  const MONTHS = ['Jan', 'Feb', 'Mär', 'Apr', 'Mai', 'Jun', 'Jul', 'Aug', 'Sep', 'Okt', 'Nov', 'Dez'];
  const WEEKDAYS = ['So', 'Mo', 'Di', 'Mi', 'Do', 'Fr', 'Sa'];
  const STORAGE_KEY = 'ajv-event-filters';
  const DEFAULT_TAGS = ['AJV'];

  let allEvents: any[] = [];
  let availableTags: string[] = [];
  let activeTags: Set<string> = new Set(DEFAULT_TAGS);

  function formatTime(dateStr: string): string {
    const d = new Date(dateStr);
    return d.toLocaleTimeString('de-CH', { hour: '2-digit', minute: '2-digit' });
  }

  function getStartDate(event: any): Date {
    if (event.start.dateTime) return new Date(event.start.dateTime);
    const [y, m, d] = event.start.date.split('-').map(Number);
    return new Date(y, m - 1, d);
  }

  function isMultiDay(event: any): boolean {
    if (!event.allDay) return false;
    const start = event.start.date;
    const end = event.end?.date;
    if (!start || !end) return false;
    const [sy, sm, sd] = start.split('-').map(Number);
    const [ey, em, ed] = end.split('-').map(Number);
    const startDate = new Date(sy, sm - 1, sd);
    const endDate = new Date(ey, em - 1, ed);
    const diffDays = (endDate.getTime() - startDate.getTime()) / (1000 * 60 * 60 * 24);
    return diffDays > 1;
  }

  function formatDateRange(event: any): string {
    const start = getStartDate(event);
    if (event.allDay) {
      if (isMultiDay(event)) {
        const [ey, em, ed] = event.end.date.split('-').map(Number);
        const endDate = new Date(ey, em - 1, ed - 1);
        return `${start.getDate()}. ${MONTHS[start.getMonth()]} – ${endDate.getDate()}. ${MONTHS[endDate.getMonth()]}`;
      }
      return 'Ganztägig';
    }
    let timeStr = formatTime(event.start.dateTime);
    if (event.end?.dateTime) {
      timeStr += ` – ${formatTime(event.end.dateTime)}`;
    }
    return timeStr;
  }

  function toGCalDate(event: any, which: 'start' | 'end'): string {
    const part = which === 'start' ? event.start : event.end;
    if (part.date) {
      return part.date.replace(/-/g, '');
    }
    return new Date(part.dateTime).toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
  }

  function getAddToGCalUrl(event: any): string {
    const title = encodeURIComponent(event.summary || '');
    const dates = `${toGCalDate(event, 'start')}/${toGCalDate(event, 'end')}`;
    const location = encodeURIComponent(event.location || '');
    const details = encodeURIComponent(event.description || '');
    return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${dates}&location=${location}&details=${details}`;
  }

  function renderAttachments(attachments: any[]): string {
    if (!attachments || attachments.length === 0) return '';
    const links = attachments.map((att: any) => {
      const title = att.title || 'Anhang';
      const url = att.fileUrl || '';
      if (!url) return '';
      return `
        <a
          href="${url}"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600 hover:text-brand-700 transition-colors"
        >
          <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13" />
          </svg>
          ${title}
        </a>
      `;
    }).filter(Boolean);
    if (links.length === 0) return '';
    return `<div class="mt-1.5 flex flex-wrap gap-3">${links.join('')}</div>`;
  }

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
  }

  function renderSourceBadge(event: any): string {
    if (!event.source || event.source === 'AJV') return '';
    return `<span class="inline-flex items-center px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-stone-500 bg-stone-100 rounded">${escapeHtml(event.source)}</span>`;
  }

  function renderEvent(event: any): string {
    const start = getStartDate(event);
    const day = start.getDate();
    const month = MONTHS[start.getMonth()];
    const weekday = WEEKDAYS[start.getDay()];
    const title = escapeHtml(event.summary || 'Ohne Titel');
    const location = escapeHtml(event.location || '');
    const timeInfo = formatDateRange(event);
    const attachmentsHtml = renderAttachments(event.attachments);
    const addUrl = getAddToGCalUrl(event);
    const sourceBadge = renderSourceBadge(event);

    if (isCompact) {
      return `
        <div class="flex items-center gap-4 py-2.5 first:pt-0 last:pb-0">
          <div class="flex-shrink-0 w-10 text-center">
            <p class="text-lg font-bold text-stone-900 leading-none">${day}</p>
            <p class="text-[10px] text-stone-500 uppercase tracking-wider">${month}</p>
          </div>
          <div class="min-w-0 flex-1 flex items-center gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex items-baseline gap-2">
                <h3 class="font-display text-sm font-semibold text-stone-900 truncate">${title}</h3>
                <span class="flex-shrink-0 text-xs text-stone-400">${timeInfo}</span>
              </div>
              ${location ? `<p class="text-xs text-stone-400 truncate">${location}</p>` : ''}
              ${attachmentsHtml}
            </div>
            <a
              href="${addUrl}"
              target="_blank"
              rel="noopener noreferrer"
              title="Zum Kalender hinzufügen"
              class="flex-shrink-0 p-1 text-stone-300 hover:text-brand-600 hover:bg-brand-50 rounded transition-colors"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </a>
          </div>
        </div>
      `;
    }

    return `
      <div class="flex gap-5 py-4 first:pt-0 last:pb-0">
        <div class="flex-shrink-0 w-14 text-center">
          <p class="text-xs font-semibold text-brand-600 uppercase tracking-wider">${weekday}</p>
          <p class="text-2xl font-bold text-stone-900 leading-tight">${day}</p>
          <p class="text-xs text-stone-500 uppercase tracking-wider">${month}</p>
        </div>
        <div class="min-w-0 flex-1">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-display font-semibold text-stone-900 leading-snug">${title}</h3>
                ${sourceBadge}
              </div>
            </div>
            <a
              href="${addUrl}"
              target="_blank"
              rel="noopener noreferrer"
              title="Zum Kalender hinzufügen"
              class="flex-shrink-0 mt-0.5 p-1.5 text-stone-300 hover:text-brand-600 hover:bg-brand-50 rounded transition-colors"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
            </a>
          </div>
          <p class="mt-1 text-sm text-stone-500">${timeInfo}</p>
          ${location ? `<p class="mt-0.5 text-sm text-stone-400 truncate">${location}</p>` : ''}
          ${attachmentsHtml}
        </div>
      </div>
    `;
  }

  function filterEvents(): any[] {
    if (activeTags.size === 0) return [];
    return allEvents.filter((e) => (e.tags || []).some((t: string) => activeTags.has(t)));
  }

  function countForTag(tag: string): number {
    return allEvents.filter((e) => (e.tags || []).includes(tag)).length;
  }

  function renderChips() {
    if (!chipsEl) return;
    chipsEl.innerHTML = availableTags
      .map((tag) => {
        const count = countForTag(tag);
        if (count === 0) return '';
        const active = activeTags.has(tag);
        const cls = active
          ? 'bg-brand-600 text-white border-brand-600 hover:bg-brand-700'
          : 'bg-white text-stone-600 border-stone-200 hover:border-brand-300 hover:text-brand-600';
        return `
          <button
            type="button"
            data-tag="${escapeHtml(tag)}"
            class="event-chip inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full border transition-colors ${cls}"
          >
            ${escapeHtml(tag)}
            <span class="text-[10px] opacity-70">${count}</span>
          </button>
        `;
      })
      .filter(Boolean)
      .join('');

    chipsEl.querySelectorAll<HTMLButtonElement>('button.event-chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        const tag = btn.dataset.tag!;
        if (activeTags.has(tag)) {
          activeTags.delete(tag);
        } else {
          activeTags.add(tag);
        }
        persistFilters();
        renderChips();
        renderList();
      });
    });
  }

  function renderList() {
    const filtered = filterEvents().slice(0, maxEvents);
    if (filtered.length === 0) {
      itemsEl.classList.add('hidden');
      emptyEl.classList.remove('hidden');
    } else {
      emptyEl.classList.add('hidden');
      itemsEl.innerHTML = filtered.map(renderEvent).join('');
      itemsEl.classList.remove('hidden');
    }
  }

  function persistFilters() {
    if (!showFilters) return;
    try {
      sessionStorage.setItem(STORAGE_KEY, JSON.stringify([...activeTags]));
    } catch {}
  }

  function loadPersistedFilters() {
    if (!showFilters) return;
    try {
      const raw = sessionStorage.getItem(STORAGE_KEY);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) activeTags = new Set(parsed);
      }
    } catch {}
  }

  async function loadEvents() {
    try {
      const res = await fetch('/api/events');
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const data = await res.json();
      allEvents = data.events || [];
      availableTags = data.tags || [];

      loadingEl.classList.add('hidden');

      if (showFilters) {
        loadPersistedFilters();
        filtersEl?.classList.remove('hidden');
        renderChips();
      }

      renderList();
      subscribeEl.classList.remove('hidden');
    } catch (e) {
      console.error('Failed to load events:', e);
      loadingEl.classList.add('hidden');
      errorEl.classList.remove('hidden');
    }
  }

  loadEvents();
</script>
