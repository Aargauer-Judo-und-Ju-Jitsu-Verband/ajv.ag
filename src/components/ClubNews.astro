---
// "Neues aus den Vereinen": neueste Beiträge der Mitgliedvereine (aus deren RSS-Feeds + Handeinträgen).
// Jeder Eintrag verlinkt auf den Originalbeitrag beim Verein.
import { getClubNews } from '../lib/clubNews';

interface Props {
  limit?: number;
  /** Abschnitt ganz ausblenden, wenn es keine Beiträge gibt (z. B. auf der Startseite) */
  hideWhenEmpty?: boolean;
  /** Hintergrund des Abschnitts */
  tone?: 'white' | 'plain';
  /** Kein Abstand oben, wenn der Abschnitt direkt an einen gleichfarbigen anschliesst */
  flushTop?: boolean;
}

const { limit = 9, hideWhenEmpty = false, tone = 'plain', flushTop = false } = Astro.props;
const items = (await getClubNews()).slice(0, limit);
const fmt = (d: Date) => d.toLocaleDateString('de-CH', { year: 'numeric', month: 'long', day: 'numeric' });
---

{(items.length > 0 || !hideWhenEmpty) && (
  <section class:list={['pb-20 lg:pb-28', flushTop ? 'pt-0' : 'pt-20 lg:pt-28', tone === 'white' && 'bg-white']} id="vereins-news">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-12">
        <div>
          <p class="text-xs font-semibold text-brand-600 uppercase tracking-[0.3em] mb-3">Aus den Vereinen</p>
          <h2 class="font-display text-3xl lg:text-4xl font-bold text-stone-900 heading-accent">Neues aus den Vereinen</h2>
        </div>
        <a href="/vereine" class="inline-flex items-center gap-2 text-sm font-semibold text-stone-500 hover:text-brand-600 transition-colors group">
          Alle Vereine &amp; ihre News
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      {items.length === 0 ? (
        <p class="text-stone-500">
          Zurzeit keine neuen Beiträge. Die News der einzelnen Vereine findest du auf der
          <a href="/vereine" class="text-brand-600 underline">Vereine-Seite</a>.
        </p>
      ) : (
        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {items.map((item) => (
            <li>
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="group block h-full">
                <article class="bg-white border border-stone-200 rounded-lg p-6 h-full flex flex-col card-hover">
                  <div class="flex items-center gap-3 mb-4">
                    <img src={item.club.logo} alt="" class="w-9 h-9 object-contain shrink-0" loading="lazy" />
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-stone-700 truncate">{item.club.name}</p>
                      <time class="text-xs text-stone-500 uppercase tracking-wider" datetime={item.date.toISOString()}>{fmt(item.date)}</time>
                    </div>
                  </div>
                  <h3 class="font-display text-lg font-semibold text-stone-900 group-hover:text-brand-600 transition-colors leading-snug">
                    {item.title}
                  </h3>
                  {item.summary && (
                    <p class="mt-3 text-sm text-stone-500 leading-relaxed line-clamp-3">{item.summary}</p>
                  )}
                  <span class="inline-flex items-center gap-1 mt-auto pt-5 text-xs font-semibold text-brand-600 uppercase tracking-wider group-hover:text-brand-700 transition-colors">
                    Beim Verein lesen
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                    <span class="sr-only">(öffnet externe Seite)</span>
                  </span>
                </article>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
)}
